      max_abs <- 1
    }
    hm_breaks <- seq(-max_abs, max_abs, length.out = 256)
    grDevices::pdf(file.path(qc_dir, "top_variable_genes.kmeans_heatmap.pdf"), width = 12, height = 10)
    pheatmap::pheatmap(
      top_mat,
      cluster_rows = FALSE,
      cluster_cols = TRUE,
      breaks = hm_breaks,
      color = hm_colors,
      annotation_col = annotation_df_informative,
      annotation_colors = annotation_colors_informative,
      show_rownames = FALSE,
      show_colnames = TRUE,
      main = "Top variable genes"
    )
    grDevices::dev.off()
  }

  if (pca_enabled) {
    pca <- stats::prcomp(t(SummarizedExperiment::assay(vst_obj)))
    pca_df <- as.data.frame(pca$x)
    pca_df$sample <- rownames(pca_df)
    for (column_name in colnames(col_data)) {
      pca_df[[column_name]] <- col_data[[column_name]]
    }
    pct <- round(100 * (pca$sdev^2 / sum(pca$sdev^2)), 2)

    plot_pca_pair <- function(pc_x, pc_y, color_col, shape_col = "") {
      xcol <- paste0("PC", pc_x)
      ycol <- paste0("PC", pc_y)
      if (!(xcol %in% colnames(pca_df)) || !(ycol %in% colnames(pca_df))) {
        return()
      }
      if (!(color_col %in% colnames(pca_df))) {
        return()
      }
      plot_df <- pca_df
      plot_df[[color_col]] <- as.factor(as.character(plot_df[[color_col]]))
      color_map <- categorical_palette(
        levels(plot_df[[color_col]]),
        palette_name = palette_name_for_column(color_col)
      )
      if (length(color_map) == 0) {
        return()
      }
      p <- ggplot2::ggplot(plot_df, ggplot2::aes_string(x = xcol, y = ycol, color = color_col))
      if (nzchar(shape_col) && shape_col %in% colnames(plot_df)) {
        plot_df[[shape_col]] <- as.factor(as.character(plot_df[[shape_col]]))
        p <- p + ggplot2::geom_point(ggplot2::aes_string(shape = shape_col), size = 3)
      } else {
        p <- p + ggplot2::geom_point(size = 3)
      }
      p <- p +
        ggplot2::scale_color_manual(values = color_map, drop = FALSE) +
        ggplot2::xlab(paste0(xcol, ": ", pct[pc_x], "% variance")) +
        ggplot2::ylab(paste0(ycol, ": ", pct[pc_y], "% variance")) +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), aspect.ratio = 1)
      shape_suffix <- if (nzchar(shape_col)) paste0("_shape_", sanitize_file_component(shape_col, "shape")) else ""
      out_name <- paste0("top_variable_genes.PCA_plot_", color_col, shape_suffix, "_PC", pc_x, "_PC", pc_y, ".pdf")
      ggplot2::ggsave(filename = file.path(qc_dir, out_name), plot = p, width = 8, height = 8)
    }

    for (color_col in pca_color_by_use) {
      shape_options <- c("", pca_shape_by_values_use)
      for (shape_col in shape_options) {
        plot_pca_pair(1, 2, color_col, shape_col)
        if (length(pca_extra_pairs) > 0) {
          for (pair in pca_extra_pairs) {
            plot_pca_pair(pair[1], pair[2], color_col, shape_col)
          }
        }
      }
    }
  }
}

build_auto_contrasts <- function() {
  candidate <- auto_primary_variable
  if (!nzchar(candidate)) {
    terms_vec <- attr(stats::terms(design_formula), "term.labels")
    terms_vec <- terms_vec[!grepl(":", terms_vec, fixed = TRUE)]
    if (length(terms_vec) == 0) {
      stop("Could not infer an auto contrast variable from the design formula.")
    }
    candidate <- terms_vec[length(terms_vec)]
  }
  if (!(candidate %in% colnames(col_data))) {
    stop("Auto contrast variable '", candidate, "' is not present in metadata.")
  }
  values <- as.factor(col_data[[candidate]])
  levels_vec <- levels(values)
  if (length(levels_vec) < 2) {
    stop("Auto contrast variable '", candidate, "' has fewer than two levels.")
  }
  contrast_list <- list()
  if (auto_pairwise) {
    for (i in seq_len(length(levels_vec) - 1)) {
      for (j in seq((i + 1), length(levels_vec))) {
        contrast_list[[length(contrast_list) + 1]] <- list(
          factor = candidate,
          numerator = levels_vec[i],
          denominator = levels_vec[j]
        )
      }
    }
  }
  contrast_list
}

contrast_plan <- if (contrast_mode == "explicit") explicit_contrasts else build_auto_contrasts()
if (length(contrast_plan) == 0) {
  stop("No DE contrasts were resolved.")
}

contrast_summaries <- list()
for (contrast_cfg in contrast_plan) {
  factor_name <- contrast_cfg$factor
  numerator <- contrast_cfg$numerator
  denominator <- contrast_cfg$denominator
  contrast_label <- sanitize_name(paste(numerator, "vs", denominator, sep = "_"))
  contrast_dir <- file.path(de_dir, contrast_label)
  dir.create(contrast_dir, recursive = TRUE, showWarnings = FALSE)

  base_res <- DESeq2::results(dds, contrast = c(factor_name, numerator, denominator), alpha = alpha)
  res_for_table <- base_res

  if (shrink_enabled) {
    shrunk <- tryCatch(
      DESeq2::lfcShrink(dds, contrast = c(factor_name, numerator, denominator), type = shrink_type),
      error = function(e) {
        message("lfcShrink failed for ", contrast_label, ": ", conditionMessage(e), ". Falling back to unshrunk results.")
        base_res
      }
    )
    if (shrink_for_tables) {
      res_for_table <- shrunk
    }
  }

  res_df <- as.data.frame(res_for_table)
  res_df$gene_id <- rownames(res_df)
  res_df$gene_symbol <- symbols_for_ids(res_df$gene_id, fallback_to_ids = TRUE)
  res_df <- res_df[, c("gene_id", "gene_symbol", setdiff(colnames(res_df), c("gene_id", "gene_symbol")))]
  res_df <- res_df[order(res_df$padj, na.last = TRUE), , drop = FALSE]

  if (write_full_results) {
    utils::write.table(
      res_df,
      file = file.path(contrast_dir, paste0(contrast_label, ".diff_genes.DESeq2.txt")),
      sep = "\t",
      quote = FALSE,
      row.names = FALSE
    )
  }

  sig_df <- subset(res_df, !is.na(padj) & padj < alpha & abs(log2FoldChange) >= lfc_for_sig)
  enrich_df <- res_df
  enrich_df$gene_symbol_clean <- enrich_df$gene_symbol
  enrich_df$gene_symbol_clean[!is_valid_symbol(enrich_df$gene_symbol_clean)] <- NA_character_
  if (write_sig_only) {
    utils::write.table(
      sig_df,
      file = file.path(contrast_dir, paste0(contrast_label, sig_suffix)),
      sep = "\t",
      quote = FALSE,
      row.names = FALSE
    )
  }

  if (ma_plot_enabled) {
    grDevices::pdf(file.path(contrast_dir, "MA Plot.pdf"), width = 8, height = 6)
    DESeq2::plotMA(res_for_table, ylim = c(-8, 8))
    grDevices::dev.off()
  }

  if (volcano_enabled) {
    vdf <- res_df
    vdf$padj[is.na(vdf$padj)] <- 1
    vdf$log2FoldChange[is.na(vdf$log2FoldChange)] <- 0
    vdf$neglog10padj <- -log10(vdf$padj)
    vdf$is_sig <- vdf$padj < alpha & abs(vdf$log2FoldChange) >= lfc_for_sig
    if (volcano_auto_axes) {
      x_lim <- max(abs(vdf$log2FoldChange), na.rm = TRUE) * 1.05
      y_lim <- max(vdf$neglog10padj[is.finite(vdf$neglog10padj)], na.rm = TRUE) * 1.05
    } else {
      x_lim <- volcano_max_xlim
      y_lim <- volcano_max_ylim
    }
    x_lim <- max(x_lim, 1)
    y_lim <- max(y_lim, 1)
    p <- ggplot2::ggplot(vdf, ggplot2::aes(x = log2FoldChange, y = neglog10padj, color = is_sig)) +
      ggplot2::geom_point(alpha = 0.7, size = 1.2) +
      ggplot2::scale_color_manual(values = c("FALSE" = "grey60", "TRUE" = "firebrick")) +
      ggplot2::geom_vline(xintercept = c(-lfc_for_sig, 0, lfc_for_sig), linetype = c("dashed", "solid", "dashed")) +
      ggplot2::geom_hline(yintercept = -log10(alpha), linetype = "dashed") +
      ggplot2::coord_cartesian(xlim = c(-x_lim, x_lim), ylim = c(0, y_lim)) +
      ggplot2::theme_light() +
      ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
      ggplot2::xlab("log2 Fold Change") +
      ggplot2::ylab("-log10 adjusted P-value")
    ggplot2::ggsave(file.path(contrast_dir, paste0(contrast_label, ".volcano_plot.pdf")), p, width = 8, height = 6)
    if (volcano_labels_enabled && requireNamespace("ggrepel", quietly = TRUE)) {
      label_df <- subset(vdf, is_sig)
      label_df <- label_df[order(label_df$padj, -abs(label_df$log2FoldChange)), , drop = FALSE]
      label_df$gene_symbol <- symbols_for_ids(label_df$gene_id, fallback_to_ids = TRUE)
      label_df <- label_df[!is.na(label_df$gene_symbol) & nzchar(label_df$gene_symbol), , drop = FALSE]
      label_df <- head(label_df, max_volcano_labels)
      if (nrow(label_df) > 0) {
        p_labels <- p + ggrepel::geom_text_repel(
          data = label_df,
          ggplot2::aes(label = gene_symbol),
          size = 3,
          max.overlaps = max_volcano_labels
        )
        ggplot2::ggsave(file.path(contrast_dir, paste0(contrast_label, ".volcano_plot_labels.pdf")), p_labels, width = 10, height = 7)
      }
    }
  }

  finite_p <- res_df$pvalue[is.finite(res_df$pvalue)]
  if (length(finite_p) > 0) {
    grDevices::pdf(file.path(contrast_dir, paste0(contrast_label, ".pvalue_histogram.pdf")), width = 8, height = 6)
    graphics::hist(
      finite_p,
      breaks = 50,
      main = paste0("P-value distribution: ", contrast_label),
      xlab = "p-value",
      col = "grey70",
      border = "white"
    )
    grDevices::dev.off()
  }

  if (sig_heatmap_enabled) {
    sig_for_heatmap <- subset(res_df, !is.na(padj) & padj < alpha & abs(log2FoldChange) >= lfc_for_heatmap)
    sig_for_heatmap$gene_symbol_plot <- symbols_for_ids(sig_for_heatmap$gene_id, fallback_to_ids = TRUE)
    sig_for_heatmap <- sig_for_heatmap[
      !is.na(sig_for_heatmap$gene_symbol_plot) & nzchar(sig_for_heatmap$gene_symbol_plot),
      ,
      drop = FALSE
    ]
    sig_for_heatmap <- sig_for_heatmap[order(sig_for_heatmap$padj, -abs(sig_for_heatmap$log2FoldChange)), , drop = FALSE]
    sig_for_heatmap <- head(sig_for_heatmap, 50)
    sig_genes <- unique(sig_for_heatmap$gene_id)
    if (length(sig_genes) >= 2) {
      hm <- SummarizedExperiment::assay(vst_obj)[sig_genes, , drop = FALSE]
      gene_labels <- sig_for_heatmap$gene_symbol_plot[match(sig_genes, sig_for_heatmap$gene_id)]
      rownames(hm) <- make.unique(gene_labels)
      hm_colors <- gradient_palette(255)
      grDevices::pdf(file.path(contrast_dir, paste0(contrast_label, ".sig_diff_genes.heatmap.pdf")), width = 10, height = 10)
      pheatmap::pheatmap(
        hm,
        color = hm_colors,
        annotation_col = annotation_df_informative,
        annotation_colors = annotation_colors_informative,
        cluster_rows = sig_heatmap_cluster_rows,
        cluster_cols = sig_heatmap_cluster_cols,
        show_rownames = TRUE,
        show_colnames = FALSE
      )
      grDevices::dev.off()
    }
  }

  genes_tested <- sum(!is.na(res_df$padj))
  sig_up <- sum(!is.na(res_df$padj) & res_df$padj < alpha & res_df$log2FoldChange >= lfc_for_sig)
  sig_down <- sum(!is.na(res_df$padj) & res_df$padj < alpha & res_df$log2FoldChange <= -lfc_for_sig)
  contrast_summary <- data.frame(
    contrast = contrast_label,
    factor = factor_name,
    numerator = numerator,
    denominator = denominator,
    genes_tested = genes_tested,
    sig_total = nrow(sig_df),
    sig_up = sig_up,
    sig_down = sig_down,
    alpha = alpha,
    lfc_threshold = lfc_for_sig,
    stringsAsFactors = FALSE
  )
  utils::write.table(
    contrast_summary,
    file = file.path(contrast_dir, paste0(contrast_label, ".summary.tsv")),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )
  contrast_summaries[[length(contrast_summaries) + 1]] <- contrast_summary

  top10_df <- subset(res_df, !is.na(padj) & abs(log2FoldChange) >= lfc_for_sig)
  top10_df <- top10_df[order(top10_df$padj, -abs(top10_df$log2FoldChange)), , drop = FALSE]
  top10_df$gene_symbol_plot <- symbols_for_ids(top10_df$gene_id, fallback_to_ids = TRUE)
  top10_df <- top10_df[!is.na(top10_df$gene_symbol_plot) & nzchar(top10_df$gene_symbol_plot), , drop = FALSE]
  top10_df <- head(top10_df, 10)
  if (nrow(top10_df) > 0 && factor_name %in% colnames(col_data)) {
    boxplot_dir <- file.path(contrast_dir, "top10_boxplots")
    dir.create(boxplot_dir, recursive = TRUE, showWarnings = FALSE)
    group_values <- as.factor(as.character(col_data[[factor_name]]))
    group_palette <- categorical_palette(
      levels(group_values),
      palette_name = palette_name_for_column(factor_name)
    )
    for (idx in seq_len(nrow(top10_df))) {
      gene_id <- top10_df$gene_id[idx]
      if (!(gene_id %in% rownames(SummarizedExperiment::assay(vst_obj)))) {
        next
      }
      gene_symbol <- top10_df$gene_symbol_plot[idx]
      if (is.na(gene_symbol) || !nzchar(gene_symbol)) {
        next
      }
      plot_df <- data.frame(
        sample = rownames(col_data),
        expression = as.numeric(SummarizedExperiment::assay(vst_obj)[gene_id, ]),
        group = group_values,
        stringsAsFactors = FALSE
      )
      p_box <- ggplot2::ggplot(plot_df, ggplot2::aes(x = group, y = expression, color = group)) +
        ggplot2::geom_boxplot(outlier.shape = NA) +
        ggplot2::geom_jitter(width = 0.15, size = 2, alpha = 0.8) +
        ggplot2::scale_color_manual(values = group_palette, drop = FALSE) +
        ggplot2::xlab(factor_name) +
        ggplot2::ylab("VST expression") +
        ggplot2::ggtitle(gene_symbol) +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none")
      plot_file <- file.path(
        boxplot_dir,
        paste0(sanitize_file_component(gene_symbol, fallback = sanitize_file_component(gene_id)), ".boxplot.pdf")
      )
      ggplot2::ggsave(plot_file, p_box, width = 7, height = 5)
    }
  }

  if (enrichment_enabled && enrichment_cp_enabled && cp_available) {
    cp_dir <- file.path(contrast_dir, "clusterProfiler")
    dir.create(cp_dir, recursive = TRUE, showWarnings = FALSE)

    universe_symbols <- unique(enrich_df$gene_symbol_clean[!is.na(enrich_df$gene_symbol_clean)])
    sig_for_enrich <- subset(enrich_df, !is.na(padj) & padj < enrichment_pvalue_cutoff)
    pos_symbols <- unique(sig_for_enrich$gene_symbol_clean[sig_for_enrich$log2FoldChange > 0 & !is.na(sig_for_enrich$gene_symbol_clean)])
    neg_symbols <- unique(sig_for_enrich$gene_symbol_clean[sig_for_enrich$log2FoldChange < 0 & !is.na(sig_for_enrich$gene_symbol_clean)])

    ranked_stats <- enrich_df$log2FoldChange
    names(ranked_stats) <- enrich_df$gene_symbol_clean
    ranked_stats <- ranked_stats[!is.na(names(ranked_stats)) & is.finite(ranked_stats)]
    ranked_stats <- deduplicate_ranked_vector(ranked_stats)

    run_ora_term2gene <- function(gene_symbols, term2gene_tbl, set_name, direction_label) {
      if (length(gene_symbols) < 2 || is.null(term2gene_tbl) || nrow(term2gene_tbl) == 0) {
        return(NULL)
      }
      ora_obj <- tryCatch(
        clusterProfiler::enricher(
          gene = gene_symbols,
          universe = universe_symbols,
          TERM2GENE = term2gene_tbl,
          pvalueCutoff = enrichment_pvalue_cutoff,
          qvalueCutoff = enrichment_qvalue_cutoff,
          minGSSize = enrichment_min_gs_size,
          maxGSSize = enrichment_max_gs_size
        ),
        error = function(e) {
          message("ORA failed for ", contrast_label, " [", set_name, ", ", direction_label, "]: ", conditionMessage(e))
          NULL
        }
      )
      ora_tbl <- safe_cp_result_table(ora_obj)
      if (is.null(ora_tbl)) {
        return(NULL)
      }
      utils::write.table(
        ora_tbl,
        file = file.path(cp_dir, paste0(contrast_label, ".", set_name, ".", direction_label, ".ORA.tsv")),
        sep = "\t",
        quote = FALSE,
        row.names = FALSE
      )
      dot_plot <- tryCatch(
        enrichplot::dotplot(ora_obj, showCategory = enrichment_top_terms) +
          ggplot2::ggtitle(paste0(contrast_label, " ", set_name, " ORA (", direction_label, ")")),
        error = function(e) NULL
      )
      save_enrichment_plot(
        dot_plot,
        file.path(cp_dir, paste0(contrast_label, ".", set_name, ".", direction_label, ".dotplot.ORA.pdf"))
      )
      bar_plot <- tryCatch(
        clusterProfiler::barplot(ora_obj, showCategory = enrichment_top_terms) +
          ggplot2::ggtitle(paste0(contrast_label, " ", set_name, " ORA (", direction_label, ")")),
        error = function(e) NULL
      )
      save_enrichment_plot(
        bar_plot,
        file.path(cp_dir, paste0(contrast_label, ".", set_name, ".", direction_label, ".barplot.ORA.pdf"))
      )
      enrichment_rows[[length(enrichment_rows) + 1]] <<- data.frame(
        contrast = contrast_label,
        method = "ORA",
        gene_set = set_name,
        direction = direction_label,
        terms = nrow(ora_tbl),
        top_term = as.character(ora_tbl$Description[[1]]),
        top_padj = as.numeric(ora_tbl$p.adjust[[1]]),
        stringsAsFactors = FALSE
      )
      ora_tbl
    }

    run_gsea_term2gene <- function(ranked_vec, term2gene_tbl, set_name) {
      if (length(ranked_vec) < 10 || is.null(term2gene_tbl) || nrow(term2gene_tbl) == 0) {
        return(NULL)
      }
      gsea_args <- list(
        geneList = ranked_vec,
        TERM2GENE = term2gene_tbl,
        pvalueCutoff = enrichment_pvalue_cutoff,
        minGSSize = enrichment_min_gs_size,
        maxGSSize = enrichment_max_gs_size,
        verbose = FALSE
      )
      if ("nPermSimple" %in% names(formals(clusterProfiler::GSEA))) {
        gsea_args$nPermSimple <- enrichment_gsea_permutations
      }
      gsea_obj <- tryCatch(
        do.call(clusterProfiler::GSEA, gsea_args),
        error = function(e) {
          message("GSEA failed for ", contrast_label, " [", set_name, "]: ", conditionMessage(e))
          NULL
        }
      )
      gsea_tbl <- safe_cp_result_table(gsea_obj)
      if (is.null(gsea_tbl)) {
        return(NULL)
      }
      utils::write.table(
        gsea_tbl,
        file = file.path(cp_dir, paste0(contrast_label, ".", set_name, ".GSEA.tsv")),
        sep = "\t",
        quote = FALSE,
        row.names = FALSE
      )
      dot_plot <- tryCatch(
        enrichplot::dotplot(gsea_obj, showCategory = enrichment_top_terms) +
          ggplot2::ggtitle(paste0(contrast_label, " ", set_name, " GSEA")),
        error = function(e) NULL
      )
      save_enrichment_plot(
        dot_plot,
        file.path(cp_dir, paste0(contrast_label, ".", set_name, ".dotplot.GSEA.pdf"))
      )
      ridge_plot <- tryCatch(
        enrichplot::ridgeplot(gsea_obj, showCategory = enrichment_top_terms) +
          ggplot2::ggtitle(paste0(contrast_label, " ", set_name, " GSEA")),
        error = function(e) NULL
      )
      save_enrichment_plot(
        ridge_plot,
        file.path(cp_dir, paste0(contrast_label, ".", set_name, ".ridgeplot.GSEA.pdf"))
      )
      top_ids <- head(as.character(gsea_tbl$ID), min(10, nrow(gsea_tbl)))
      if (length(top_ids) > 0) {
        for (term_id in top_ids) {
          gp <- tryCatch(
            enrichplot::gseaplot2(gsea_obj, geneSetID = term_id, title = term_id),
            error = function(e) NULL
          )
          save_enrichment_plot(
            gp,
            file.path(
              cp_dir,
              paste0(contrast_label, ".", set_name, ".nesplot.", sanitize_file_component(term_id, "term"), ".GSEA.pdf")
            ),
            width = 10,
            height = 6
          )
        }
      }
      enrichment_rows[[length(enrichment_rows) + 1]] <<- data.frame(
        contrast = contrast_label,
        method = "GSEA",
        gene_set = set_name,
        direction = "ranked",
        terms = nrow(gsea_tbl),
        top_term = as.character(gsea_tbl$Description[[1]]),
        top_padj = as.numeric(gsea_tbl$p.adjust[[1]]),
        stringsAsFactors = FALSE
      )
      gsea_tbl
    }

    if (enrichment_cp_run_ora) {
      for (set_name in names(msig_term2gene)) {
        run_ora_term2gene(pos_symbols, msig_term2gene[[set_name]], set_name, "up")
        run_ora_term2gene(neg_symbols, msig_term2gene[[set_name]], set_name, "down")
      }
    }

    if (enrichment_cp_run_gsea) {
      for (set_name in names(msig_term2gene)) {
        run_gsea_term2gene(ranked_stats, msig_term2gene[[set_name]], set_name)
      }
    }
  }

  if (enrichment_enabled && decoupler_enabled && decoupler_available &&
      (decoupler_run_progeny || decoupler_run_tf_network)) {
    dc_dir <- file.path(contrast_dir, "decoupler")
    dir.create(dc_dir, recursive = TRUE, showWarnings = FALSE)

    sample_symbol_ids <- symbols_for_ids(rownames(SummarizedExperiment::assay(vst_obj)), fallback_to_ids = FALSE)
    sample_symbol_ids[!is_valid_symbol(sample_symbol_ids)] <- NA_character_
    dc_sample_mat <- aggregate_symbol_matrix(SummarizedExperiment::assay(vst_obj), sample_symbol_ids)

    deg_symbol_ids <- enrich_df$gene_symbol_clean
    dc_deg_mat_raw <- matrix(
      enrich_df$log2FoldChange,
      ncol = 1,
      dimnames = list(deg_symbol_ids, contrast_label)
    )
    dc_deg_mat <- aggregate_symbol_matrix(dc_deg_mat_raw, rownames(dc_deg_mat_raw))

    dc_deg_stats <- enrich_df[, c("gene_symbol_clean", "log2FoldChange", "pvalue"), drop = FALSE]
    dc_deg_stats <- dc_deg_stats[!is.na(dc_deg_stats$gene_symbol_clean), , drop = FALSE]
    dc_deg_stats <- dc_deg_stats[order(abs(dc_deg_stats$log2FoldChange), decreasing = TRUE), , drop = FALSE]
    dc_deg_stats <- dc_deg_stats[!duplicated(dc_deg_stats$gene_symbol_clean), , drop = FALSE]
    rownames(dc_deg_stats) <- dc_deg_stats$gene_symbol_clean

    species_dc <- if (species_info$species_label %in% c("human", "mouse")) species_info$species_label else "human"

    safe_decouple_run <- function(fun_name, mat, net, mor_col) {
      if (!(fun_name %in% getNamespaceExports("decoupleR"))) {
        return(NULL)
      }
      fun <- get(fun_name, envir = asNamespace("decoupleR"))
      tryCatch(
        fun(
          mat = mat,
          net = net,
          .source = "source",
          .target = "target",
          .mor = mor_col,
          minsize = decoupler_minsize
        ),
        error = function(e) {
          message("decoupleR ", fun_name, " failed in ", contrast_label, ": ", conditionMessage(e))
          NULL
        }
      )
    }

    plot_decoupler_detail <- function(net_tbl, activity_tbl, mor_col, out_prefix, label_suffix) {
      if (is.null(activity_tbl) || nrow(activity_tbl) == 0) {
        return()
      }
      activity_tbl <- activity_tbl[is.finite(activity_tbl$score), , drop = FALSE]
      if (nrow(activity_tbl) == 0) {
        return()
      }
      activity_tbl <- activity_tbl[order(activity_tbl$score), , drop = FALSE]
      n_each <- min(decoupler_top_regulators_detail_each_side, floor(nrow(activity_tbl) / 2))
      if (n_each < 1) {
        return()
      }
      top_regs <- c(
        head(activity_tbl$source, n_each),
        tail(activity_tbl$source, n_each)
      )
      top_regs <- unique(as.character(top_regs))
      cols <- rev(RColorBrewer::brewer.pal(n = 11, name = "RdBu")[c(2, 10)])
      for (reg in top_regs) {
        reg_net <- net_tbl[net_tbl$source == reg, c("target", mor_col), drop = FALSE]
        colnames(reg_net) <- c("target", "mor_value")
        reg_net <- reg_net[!is.na(reg_net$target), , drop = FALSE]
        if (nrow(reg_net) == 0) {
          next
        }
        inter <- intersect(reg_net$target, rownames(dc_deg_stats))
        if (length(inter) < 3) {
          next
        }
        plot_df <- data.frame(
          target = inter,
          mor = reg_net$mor_value[match(inter, reg_net$target)],
          logfc = dc_deg_stats[inter, "log2FoldChange"],
          pvalue = dc_deg_stats[inter, "pvalue"],
          stringsAsFactors = FALSE
        )
        plot_df$color_class <- "neutral"
        plot_df$color_class[plot_df$mor > 0 & plot_df$logfc > 0] <- "concordant"
        plot_df$color_class[plot_df$mor < 0 & plot_df$logfc < 0] <- "concordant"
        plot_df$color_class[plot_df$mor > 0 & plot_df$logfc < 0] <- "discordant"
        plot_df$color_class[plot_df$mor < 0 & plot_df$logfc > 0] <- "discordant"
        p <- ggplot2::ggplot(
          plot_df,
          ggplot2::aes(x = mor, y = logfc, color = color_class)
        ) +
          ggplot2::geom_point(size = 2) +
          ggplot2::scale_color_manual(values = c("concordant" = cols[2], "discordant" = cols[1], "neutral" = "grey60")) +
          ggplot2::geom_vline(xintercept = 0, linetype = "dotted") +
          ggplot2::geom_hline(yintercept = 0, linetype = "dotted") +
          ggplot2::theme_light() +
          ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
          ggplot2::xlab("Network weight") +
          ggplot2::ylab("log2 fold change") +
          ggplot2::ggtitle(reg)
        if (requireNamespace("ggrepel", quietly = TRUE)) {
          p <- p + ggrepel::geom_text_repel(
            data = head(plot_df[order(abs(plot_df$logfc), decreasing = TRUE), , drop = FALSE], 20),
            ggplot2::aes(label = target),
            size = 3
          )
        }
        save_enrichment_plot(
          p,
          file.path(dc_dir, paste0(out_prefix, ".DE_genes.in.", sanitize_file_component(reg, "regulator"), ".", label_suffix, ".pdf")),
          width = 9,
          height = 7
        )
      }
    }

    if (decoupler_run_progeny && nrow(dc_sample_mat) >= 20 && nrow(dc_deg_mat) >= 20 &&
        "get_progeny" %in% getNamespaceExports("decoupleR")) {
      prog_net <- tryCatch(
        decoupleR::get_progeny(organism = species_dc, top = decoupler_progeny_top),
        error = function(e) {
          message("get_progeny failed in ", contrast_label, ": ", conditionMessage(e))
          NULL
        }
      )
      if (!is.null(prog_net) && nrow(prog_net) > 0) {
        prog_all <- safe_decouple_run("run_mlm", dc_sample_mat, prog_net, "weight")
        prog_deg <- safe_decouple_run("run_mlm", dc_deg_mat, prog_net, "weight")
        if (!is.null(prog_all)) {
          utils::write.table(
            prog_all,
            file = file.path(dc_dir, paste0(contrast_label, ".all_genes.progeny_pathways.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          prog_all_mat <- decoupler_to_matrix(as.data.frame(prog_all))
          plot_decoupler_heatmap(
            prog_all_mat,
            file.path(dc_dir, paste0(contrast_label, ".all_genes.progeny_pathways.pdf")),
            paste0(contrast_label, " progeny pathway activity"),
            top_features = decoupler_top_features_heatmap
          )
        }
        if (!is.null(prog_deg)) {
          utils::write.table(
            prog_deg,
            file = file.path(dc_dir, paste0(contrast_label, ".DE_genes.progeny_pathways.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          plot_decoupler_bar(
            as.data.frame(prog_deg),
            file.path(dc_dir, paste0(contrast_label, ".DE_genes.progeny_pathways.pdf")),
            paste0(contrast_label, " progeny pathway activity (DE genes)"),
            top_n = decoupler_top_regulators_barplot
          )
          plot_decoupler_detail(
            net_tbl = prog_net,
            activity_tbl = as.data.frame(prog_deg),
            mor_col = "weight",
            out_prefix = contrast_label,
            label_suffix = "progeny_pathway"
          )
          prog_deg_tbl <- as.data.frame(prog_deg)
          if (all(c("source", "score") %in% colnames(prog_deg_tbl))) {
            top_prog <- prog_deg_tbl[order(-abs(prog_deg_tbl$score)), , drop = FALSE]
            enrichment_rows[[length(enrichment_rows) + 1]] <- data.frame(
              contrast = contrast_label,
              method = "decoupleR_MLM",
              gene_set = "progeny",
              direction = "ranked",
              terms = nrow(prog_deg_tbl),
              top_term = as.character(top_prog$source[[1]]),
              top_padj = NA_real_,
              stringsAsFactors = FALSE
            )
          }
        }
      }
    }

    if (decoupler_run_tf_network && nrow(dc_sample_mat) >= 20 && nrow(dc_deg_mat) >= 20 &&
        "get_collectri" %in% getNamespaceExports("decoupleR")) {
      tf_net <- tryCatch(
        decoupleR::get_collectri(organism = species_dc, split_complexes = decoupler_tf_split_complexes),
        error = function(e) {
          message("get_collectri failed in ", contrast_label, ": ", conditionMessage(e))
          NULL
        }
      )
      if (!is.null(tf_net) && nrow(tf_net) > 0) {
        tf_all <- safe_decouple_run("run_ulm", dc_sample_mat, tf_net, "mor")
        tf_deg <- safe_decouple_run("run_ulm", dc_deg_mat, tf_net, "mor")
        if (!is.null(tf_all)) {
          utils::write.table(
            tf_all,
            file = file.path(dc_dir, paste0(contrast_label, ".all_genes.TF_network_activity.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          tf_all_mat <- decoupler_to_matrix(as.data.frame(tf_all))
          plot_decoupler_heatmap(
            tf_all_mat,
            file.path(dc_dir, paste0(contrast_label, ".all_genes.TF_network_activity.pdf")),
            paste0(contrast_label, " TF network activity"),
            top_features = decoupler_top_features_heatmap
          )
        }
        if (!is.null(tf_deg)) {
          utils::write.table(
            tf_deg,
            file = file.path(dc_dir, paste0(contrast_label, ".DE_genes.TF_network_activity.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          plot_decoupler_bar(
            as.data.frame(tf_deg),
            file.path(dc_dir, paste0(contrast_label, ".DE_genes.TF_network_activity.pdf")),
            paste0(contrast_label, " TF network activity (DE genes)"),
            top_n = decoupler_top_regulators_barplot
          )
          plot_decoupler_detail(
            net_tbl = tf_net,
            activity_tbl = as.data.frame(tf_deg),
            mor_col = "mor",
            out_prefix = contrast_label,
            label_suffix = "TF_network_activity"
          )
          tf_deg_tbl <- as.data.frame(tf_deg)
          if (all(c("source", "score") %in% colnames(tf_deg_tbl))) {
            top_tf <- tf_deg_tbl[order(-abs(tf_deg_tbl$score)), , drop = FALSE]
            enrichment_rows[[length(enrichment_rows) + 1]] <- data.frame(
              contrast = contrast_label,
              method = "decoupleR_ULM",
              gene_set = "collectri_tf",
              direction = "ranked",
              terms = nrow(tf_deg_tbl),
              top_term = as.character(top_tf$source[[1]]),
              top_padj = NA_real_,
              stringsAsFactors = FALSE
            )
          }
        }
      }
    }
  }
}

if (length(contrast_summaries) > 0) {
  contrast_summary_table <- do.call(rbind, contrast_summaries)
  utils::write.table(
    contrast_summary_table,
    file = file.path(de_dir, "contrast_summary.tsv"),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )

  summary_plot_df <- rbind(
    data.frame(
      contrast = contrast_summary_table$contrast,
      direction = "up",
      count = contrast_summary_table$sig_up,
      stringsAsFactors = FALSE
    ),
    data.frame(
      contrast = contrast_summary_table$contrast,
      direction = "down",
      count = contrast_summary_table$sig_down,
      stringsAsFactors = FALSE
    )
  )
  summary_plot_df$contrast <- factor(
    summary_plot_df$contrast,
    levels = contrast_summary_table$contrast[order(contrast_summary_table$sig_total, decreasing = TRUE)]
  )
  summary_plot_df$direction <- factor(summary_plot_df$direction, levels = c("up", "down"))

  p_summary <- ggplot2::ggplot(summary_plot_df, ggplot2::aes(x = contrast, y = count, fill = direction)) +
    ggplot2::geom_col(position = "dodge") +
    ggplot2::scale_fill_manual(values = c("up" = "firebrick", "down" = "steelblue")) +
    ggplot2::xlab("Contrast") +
    ggplot2::ylab("Significant genes") +
    ggplot2::theme_light() +
    ggplot2::theme(
      panel.grid = ggplot2::element_blank(),
      axis.text.x = ggplot2::element_text(angle = 30, hjust = 1),
      legend.title = ggplot2::element_blank()
    )
  ggplot2::ggsave(
    filename = file.path(de_dir, "contrast_summary.sig_up_down_barplot.pdf"),
    plot = p_summary,
    width = 10,
    height = 6
  )
}

if (length(enrichment_rows) > 0) {
  enrichment_summary <- do.call(rbind, enrichment_rows)
  enrichment_summary <- enrichment_summary[order(enrichment_summary$contrast, enrichment_summary$method, enrichment_summary$gene_set), , drop = FALSE]
  utils::write.table(
    enrichment_summary,
    file = file.path(de_dir, "enrichment_summary.tsv"),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )
}

writeLines(capture.output(sessionInfo()), con = file.path(qc_dir, "sessionInfo.txt"))
