if (qc_enabled) {
  pca_color_by_use <- pca_color_by[
    pca_color_by %in% colnames(col_data) &
      vapply(pca_color_by, function(x) is_informative_column(col_data, x), logical(1))
  ]
  pca_shape_by_values_use <- pca_shape_by_values[
    pca_shape_by_values %in% colnames(col_data) &
      vapply(pca_shape_by_values, function(x) is_informative_column(col_data, x), logical(1))
  ]
  pca_color_by_use <- unique(c(pca_color_by_use, auto_categorical_columns))
  pca_color_by_use <- unique(c(de_columns_resolved, pca_color_by_use))

  if (distance_plot_enabled) {
    dist_mat <- as.matrix(stats::dist(t(SummarizedExperiment::assay(vst_obj))))
    label_columns <- informative_annotation_columns
    label_columns <- label_columns[seq_len(min(3, length(label_columns)))]
    if (length(label_columns) > 0) {
      sample_labels <- apply(
        cbind(sample = rownames(col_data), col_data[, label_columns, drop = FALSE]),
        1,
        function(x) paste(x, collapse = " : ")
      )
      rownames(dist_mat) <- sample_labels
      colnames(dist_mat) <- sample_labels
    }
    grDevices::pdf(file.path(qc_dir, "top_variable_genes.distance_plot.pdf"), width = 10, height = 10)
    pheatmap::pheatmap(dist_mat, main = "Sample distance")
    grDevices::dev.off()
  }

  if (variable_heatmap_enabled) {
    top_idx <- head(order(-matrixStats::rowVars(SummarizedExperiment::assay(vst_obj))), top_variable_genes)
    top_mat <- SummarizedExperiment::assay(vst_obj)[top_idx, , drop = FALSE]
    top_mat <- row_zscore(top_mat)
    keep_rows <- is.finite(rowMeans(top_mat))
    top_mat <- top_mat[keep_rows, , drop = FALSE]
    if (nrow(top_mat) > 1) {
      k <- min(5, nrow(top_mat))
      km <- stats::kmeans(top_mat, centers = k, iter.max = 20, nstart = 20)
      top_mat <- top_mat[names(sort(km$cluster)), , drop = FALSE]
    }
    hm_colors <- gradient_palette(255)
    max_abs <- max(abs(top_mat), na.rm = TRUE)
    if (!is.finite(max_abs) || max_abs <= 0) {
      max_abs <- 1
    }
    hm_breaks <- seq(-max_abs, max_abs, length.out = 256)
    grDevices::pdf(file.path(qc_dir, "top_variable_genes.kmeans_heatmap.pdf"), width = 12, height = 10)
    pheatmap::pheatmap(
      top_mat,
      cluster_rows = FALSE,
      cluster_cols = TRUE,
      breaks = hm_breaks,
      color = hm_colors,
      annotation_col = annotation_df_informative,
      annotation_colors = annotation_colors_informative,
      show_rownames = FALSE,
      show_colnames = TRUE,
      main = "Top variable genes"
    )
    grDevices::dev.off()
  }

  if (pca_enabled) {
    pca <- stats::prcomp(t(SummarizedExperiment::assay(vst_obj)))
    pca_df <- as.data.frame(pca$x)
    pca_df$sample <- rownames(pca_df)
    for (column_name in colnames(col_data)) {
      pca_df[[column_name]] <- col_data[[column_name]]
    }
    pct <- round(100 * (pca$sdev^2 / sum(pca$sdev^2)), 2)

    plot_pca_pair <- function(pc_x, pc_y, color_col, shape_col = "") {
      xcol <- paste0("PC", pc_x)
      ycol <- paste0("PC", pc_y)
      if (!(xcol %in% colnames(pca_df)) || !(ycol %in% colnames(pca_df))) {
        return()
      }
      if (!(color_col %in% colnames(pca_df))) {
        return()
      }
      plot_df <- pca_df
      plot_df[[color_col]] <- as.factor(as.character(plot_df[[color_col]]))
      color_map <- categorical_palette(
        levels(plot_df[[color_col]]),
        palette_name = palette_name_for_column(color_col)
      )
      if (length(color_map) == 0) {
        return()
      }
      p <- ggplot2::ggplot(plot_df, ggplot2::aes_string(x = xcol, y = ycol, color = color_col))
      if (nzchar(shape_col) && shape_col %in% colnames(plot_df)) {
        plot_df[[shape_col]] <- as.factor(as.character(plot_df[[shape_col]]))
        p <- p + ggplot2::geom_point(ggplot2::aes_string(shape = shape_col), size = 3)
      } else {
        p <- p + ggplot2::geom_point(size = 3)
      }
      p <- p +
        ggplot2::scale_color_manual(values = color_map, drop = FALSE) +
        ggplot2::xlab(paste0(xcol, ": ", pct[pc_x], "% variance")) +
        ggplot2::ylab(paste0(ycol, ": ", pct[pc_y], "% variance")) +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), aspect.ratio = 1)
      shape_suffix <- if (nzchar(shape_col)) paste0("_shape_", sanitize_file_component(shape_col, "shape")) else ""
      out_name <- paste0("top_variable_genes.PCA_plot_", color_col, shape_suffix, "_PC", pc_x, "_PC", pc_y, ".pdf")
      ggplot2::ggsave(filename = file.path(qc_dir, out_name), plot = p, width = 8, height = 8)
    }

    for (color_col in pca_color_by_use) {
      shape_options <- c("", pca_shape_by_values_use)
      for (shape_col in shape_options) {
        plot_pca_pair(1, 2, color_col, shape_col)
        if (length(pca_extra_pairs) > 0) {
          for (pair in pca_extra_pairs) {
            plot_pca_pair(pair[1], pair[2], color_col, shape_col)
          }
        }
      }
    }
  }
}

build_auto_contrasts <- function() {
  candidate <- auto_primary_variable
  if (!nzchar(candidate)) {
    terms_vec <- attr(stats::terms(design_formula), "term.labels")
    terms_vec <- terms_vec[!grepl(":", terms_vec, fixed = TRUE)]
    if (length(terms_vec) == 0) {
      stop("Could not infer an auto contrast variable from the design formula.")
    }
    candidate <- terms_vec[length(terms_vec)]
  }
  if (!(candidate %in% colnames(col_data))) {
    stop("Auto contrast variable '", candidate, "' is not present in metadata.")
  }
  values <- as.factor(col_data[[candidate]])
  levels_vec <- levels(values)
  if (length(levels_vec) < 2) {
    stop("Auto contrast variable '", candidate, "' has fewer than two levels.")
  }
  contrast_list <- list()
  if (auto_pairwise) {
    for (i in seq_len(length(levels_vec) - 1)) {
      for (j in seq((i + 1), length(levels_vec))) {
        contrast_list[[length(contrast_list) + 1]] <- list(
          factor = candidate,
          numerator = levels_vec[i],
          denominator = levels_vec[j]
        )
      }
    }
  }
  contrast_list
}

contrast_plan <- if (contrast_mode == "explicit") explicit_contrasts else build_auto_contrasts()
if (length(contrast_plan) == 0) {
  stop("No DE contrasts were resolved.")
}

contrast_summaries <- list()
for (contrast_cfg in contrast_plan) {
  factor_name <- contrast_cfg$factor
  numerator <- contrast_cfg$numerator
  denominator <- contrast_cfg$denominator
  contrast_label <- sanitize_name(paste(numerator, "vs", denominator, sep = "_"))
  contrast_dir <- file.path(de_dir, contrast_label)
  dir.create(contrast_dir, recursive = TRUE, showWarnings = FALSE)

  base_res <- DESeq2::results(dds, contrast = c(factor_name, numerator, denominator), alpha = alpha)
  res_for_table <- base_res

  if (shrink_enabled) {
    shrunk <- tryCatch(
      DESeq2::lfcShrink(dds, contrast = c(factor_name, numerator, denominator), type = shrink_type),
      error = function(e) {
        message("lfcShrink failed for ", contrast_label, ": ", conditionMessage(e), ". Falling back to unshrunk results.")
        base_res
      }
    )
    if (shrink_for_tables) {
      res_for_table <- shrunk
    }
  }

  res_df <- as.data.frame(res_for_table)
  res_df$gene_id <- rownames(res_df)
  res_df$gene_symbol <- symbols_for_ids(res_df$gene_id, fallback_to_ids = TRUE)
  res_df <- res_df[, c("gene_id", "gene_symbol", setdiff(colnames(res_df), c("gene_id", "gene_symbol")))]
  res_df <- res_df[order(res_df$padj, na.last = TRUE), , drop = FALSE]

  if (write_full_results) {
    utils::write.table(
      res_df,
      file = file.path(contrast_dir, paste0(contrast_label, ".diff_genes.DESeq2.txt")),
      sep = "\t",
      quote = FALSE,
      row.names = FALSE
    )
  }

  sig_df <- subset(res_df, !is.na(padj) & padj < alpha & abs(log2FoldChange) >= lfc_for_sig)
  if (write_sig_only) {
    utils::write.table(
      sig_df,
      file = file.path(contrast_dir, paste0(contrast_label, sig_suffix)),
      sep = "\t",
      quote = FALSE,
      row.names = FALSE
    )
  }

  if (ma_plot_enabled) {
    grDevices::pdf(file.path(contrast_dir, "MA Plot.pdf"), width = 8, height = 6)
    DESeq2::plotMA(res_for_table, ylim = c(-8, 8))
    grDevices::dev.off()
  }

  if (volcano_enabled) {
    vdf <- res_df
    vdf$padj[is.na(vdf$padj)] <- 1
    vdf$log2FoldChange[is.na(vdf$log2FoldChange)] <- 0
    vdf$neglog10padj <- -log10(vdf$padj)
    vdf$is_sig <- vdf$padj < alpha & abs(vdf$log2FoldChange) >= lfc_for_sig
    if (volcano_auto_axes) {
      x_lim <- max(abs(vdf$log2FoldChange), na.rm = TRUE) * 1.05
      y_lim <- max(vdf$neglog10padj[is.finite(vdf$neglog10padj)], na.rm = TRUE) * 1.05
    } else {
      x_lim <- volcano_max_xlim
      y_lim <- volcano_max_ylim
    }
    x_lim <- max(x_lim, 1)
    y_lim <- max(y_lim, 1)
    p <- ggplot2::ggplot(vdf, ggplot2::aes(x = log2FoldChange, y = neglog10padj, color = is_sig)) +
      ggplot2::geom_point(alpha = 0.7, size = 1.2) +
      ggplot2::scale_color_manual(values = c("FALSE" = "grey60", "TRUE" = "firebrick")) +
      ggplot2::geom_vline(xintercept = c(-lfc_for_sig, 0, lfc_for_sig), linetype = c("dashed", "solid", "dashed")) +
      ggplot2::geom_hline(yintercept = -log10(alpha), linetype = "dashed") +
      ggplot2::coord_cartesian(xlim = c(-x_lim, x_lim), ylim = c(0, y_lim)) +
      ggplot2::theme_light() +
      ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
      ggplot2::xlab("log2 Fold Change") +
      ggplot2::ylab("-log10 adjusted P-value")
    ggplot2::ggsave(file.path(contrast_dir, paste0(contrast_label, ".volcano_plot.pdf")), p, width = 8, height = 6)
    if (volcano_labels_enabled && requireNamespace("ggrepel", quietly = TRUE)) {
      label_df <- subset(vdf, is_sig)
      label_df <- label_df[order(label_df$padj, -abs(label_df$log2FoldChange)), , drop = FALSE]
      label_df$gene_symbol <- symbols_for_ids(label_df$gene_id, fallback_to_ids = TRUE)
      label_df <- label_df[!is.na(label_df$gene_symbol) & nzchar(label_df$gene_symbol), , drop = FALSE]
      label_df <- head(label_df, max_volcano_labels)
      if (nrow(label_df) > 0) {
        p_labels <- p + ggrepel::geom_text_repel(
          data = label_df,
          ggplot2::aes(label = gene_symbol),
          size = 3,
          max.overlaps = max_volcano_labels
        )
        ggplot2::ggsave(file.path(contrast_dir, paste0(contrast_label, ".volcano_plot_labels.pdf")), p_labels, width = 10, height = 7)
      }
    }
  }

  finite_p <- res_df$pvalue[is.finite(res_df$pvalue)]
  if (length(finite_p) > 0) {
    grDevices::pdf(file.path(contrast_dir, paste0(contrast_label, ".pvalue_histogram.pdf")), width = 8, height = 6)
    graphics::hist(
      finite_p,
      breaks = 50,
      main = paste0("P-value distribution: ", contrast_label),
      xlab = "p-value",
      col = "grey70",
      border = "white"
    )
    grDevices::dev.off()
  }

  if (sig_heatmap_enabled) {
    sig_for_heatmap <- subset(res_df, !is.na(padj) & padj < alpha & abs(log2FoldChange) >= lfc_for_heatmap)
    sig_for_heatmap$gene_symbol_plot <- symbols_for_ids(sig_for_heatmap$gene_id, fallback_to_ids = TRUE)
    sig_for_heatmap <- sig_for_heatmap[
      !is.na(sig_for_heatmap$gene_symbol_plot) & nzchar(sig_for_heatmap$gene_symbol_plot),
      ,
      drop = FALSE
    ]
    sig_for_heatmap <- sig_for_heatmap[order(sig_for_heatmap$padj, -abs(sig_for_heatmap$log2FoldChange)), , drop = FALSE]
    sig_for_heatmap <- head(sig_for_heatmap, 50)
    sig_genes <- unique(sig_for_heatmap$gene_id)
    if (length(sig_genes) >= 2) {
      hm <- SummarizedExperiment::assay(vst_obj)[sig_genes, , drop = FALSE]
      gene_labels <- sig_for_heatmap$gene_symbol_plot[match(sig_genes, sig_for_heatmap$gene_id)]
      rownames(hm) <- make.unique(gene_labels)
      hm_colors <- gradient_palette(255)
      grDevices::pdf(file.path(contrast_dir, paste0(contrast_label, ".sig_diff_genes.heatmap.pdf")), width = 10, height = 10)
      pheatmap::pheatmap(
        hm,
        color = hm_colors,
        annotation_col = annotation_df_informative,
        annotation_colors = annotation_colors_informative,
        cluster_rows = sig_heatmap_cluster_rows,
        cluster_cols = sig_heatmap_cluster_cols,
        show_rownames = TRUE,
        show_colnames = FALSE
      )
      grDevices::dev.off()
    }
  }

  genes_tested <- sum(!is.na(res_df$padj))
  sig_up <- sum(!is.na(res_df$padj) & res_df$padj < alpha & res_df$log2FoldChange >= lfc_for_sig)
  sig_down <- sum(!is.na(res_df$padj) & res_df$padj < alpha & res_df$log2FoldChange <= -lfc_for_sig)
  contrast_summary <- data.frame(
    contrast = contrast_label,
    factor = factor_name,
    numerator = numerator,
    denominator = denominator,
    genes_tested = genes_tested,
    sig_total = nrow(sig_df),
    sig_up = sig_up,
    sig_down = sig_down,
    alpha = alpha,
    lfc_threshold = lfc_for_sig,
    stringsAsFactors = FALSE
  )
  utils::write.table(
    contrast_summary,
    file = file.path(contrast_dir, paste0(contrast_label, ".summary.tsv")),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )
  contrast_summaries[[length(contrast_summaries) + 1]] <- contrast_summary

  top10_df <- subset(res_df, !is.na(padj) & abs(log2FoldChange) >= lfc_for_sig)
  top10_df <- top10_df[order(top10_df$padj, -abs(top10_df$log2FoldChange)), , drop = FALSE]
  top10_df$gene_symbol_plot <- symbols_for_ids(top10_df$gene_id, fallback_to_ids = TRUE)
  top10_df <- top10_df[!is.na(top10_df$gene_symbol_plot) & nzchar(top10_df$gene_symbol_plot), , drop = FALSE]
  top10_df <- head(top10_df, 10)
  if (nrow(top10_df) > 0 && factor_name %in% colnames(col_data)) {
    boxplot_dir <- file.path(contrast_dir, "top10_boxplots")
    dir.create(boxplot_dir, recursive = TRUE, showWarnings = FALSE)
    group_values <- as.factor(as.character(col_data[[factor_name]]))
    group_palette <- categorical_palette(
      levels(group_values),
      palette_name = palette_name_for_column(factor_name)
    )
    for (idx in seq_len(nrow(top10_df))) {
      gene_id <- top10_df$gene_id[idx]
      if (!(gene_id %in% rownames(SummarizedExperiment::assay(vst_obj)))) {
        next
      }
      gene_symbol <- top10_df$gene_symbol_plot[idx]
      if (is.na(gene_symbol) || !nzchar(gene_symbol)) {
        next
      }
      plot_df <- data.frame(
        sample = rownames(col_data),
        expression = as.numeric(SummarizedExperiment::assay(vst_obj)[gene_id, ]),
        group = group_values,
        stringsAsFactors = FALSE
      )
      p_box <- ggplot2::ggplot(plot_df, ggplot2::aes(x = group, y = expression, color = group)) +
        ggplot2::geom_boxplot(outlier.shape = NA) +
        ggplot2::geom_jitter(width = 0.15, size = 2, alpha = 0.8) +
        ggplot2::scale_color_manual(values = group_palette, drop = FALSE) +
        ggplot2::xlab(factor_name) +
        ggplot2::ylab("VST expression") +
        ggplot2::ggtitle(gene_symbol) +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none")
      plot_file <- file.path(
        boxplot_dir,
        paste0(sanitize_file_component(gene_symbol, fallback = sanitize_file_component(gene_id)), ".boxplot.pdf")
      )
      ggplot2::ggsave(plot_file, p_box, width = 7, height = 5)
    }
  }
}

if (length(contrast_summaries) > 0) {
  contrast_summary_table <- do.call(rbind, contrast_summaries)
  utils::write.table(
    contrast_summary_table,
    file = file.path(de_dir, "contrast_summary.tsv"),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )

  summary_plot_df <- rbind(
    data.frame(
      contrast = contrast_summary_table$contrast,
      direction = "up",
      count = contrast_summary_table$sig_up,
      stringsAsFactors = FALSE
    ),
    data.frame(
      contrast = contrast_summary_table$contrast,
      direction = "down",
      count = contrast_summary_table$sig_down,
      stringsAsFactors = FALSE
    )
  )
  summary_plot_df$contrast <- factor(
    summary_plot_df$contrast,
    levels = contrast_summary_table$contrast[order(contrast_summary_table$sig_total, decreasing = TRUE)]
  )
  summary_plot_df$direction <- factor(summary_plot_df$direction, levels = c("up", "down"))

  p_summary <- ggplot2::ggplot(summary_plot_df, ggplot2::aes(x = contrast, y = count, fill = direction)) +
    ggplot2::geom_col(position = "dodge") +
    ggplot2::scale_fill_manual(values = c("up" = "firebrick", "down" = "steelblue")) +
    ggplot2::xlab("Contrast") +
    ggplot2::ylab("Significant genes") +
    ggplot2::theme_light() +
    ggplot2::theme(
      panel.grid = ggplot2::element_blank(),
      axis.text.x = ggplot2::element_text(angle = 30, hjust = 1),
      legend.title = ggplot2::element_blank()
    )
  ggplot2::ggsave(
    filename = file.path(de_dir, "contrast_summary.sig_up_down_barplot.pdf"),
    plot = p_summary,
    width = 10,
    height = 6
  )
}

writeLines(capture.output(sessionInfo()), con = file.path(qc_dir, "sessionInfo.txt"))
