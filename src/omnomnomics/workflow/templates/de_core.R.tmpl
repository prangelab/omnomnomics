sanitize_name <- function(x) {
  x <- gsub("[^A-Za-z0-9._-]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^[_\\.\\-]+|[_\\.\\-]+$", "", x)
  if (!nzchar(x)) "contrast" else x
}

sanitize_file_component <- function(x, fallback = "item") {
  x <- gsub("[^A-Za-z0-9._-]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^[_\\.\\-]+|[_\\.\\-]+$", "", x)
  if (!nzchar(x)) fallback else x
}

is_informative_column <- function(df, column_name) {
  if (!(column_name %in% colnames(df))) {
    return(FALSE)
  }
  values <- as.character(df[[column_name]])
  values <- values[!is.na(values) & nzchar(values)]
  n_unique <- length(unique(values))
  n_unique >= 2 && n_unique < nrow(df)
}

is_categorical_grouping_column <- function(df, column_name) {
  if (!(column_name %in% colnames(df))) {
    return(FALSE)
  }
  values_raw <- df[[column_name]]
  if (is.numeric(values_raw) || is.integer(values_raw)) {
    return(FALSE)
  }
  is_informative_column(df, column_name)
}

qualitative_palette_names <- c("Set1", "Dark2", "Paired", "Set2", "Accent", "Pastel1", "Pastel2", "Set3")
palette_cache <- new.env(parent = emptyenv())
palette_assignment_rows <- list()

palette_name_for_column <- function(column_name) {
  column_name <- as.character(column_name)
  if (!nzchar(column_name)) {
    return(qualitative_palette_names[[1]])
  }
  if (exists(column_name, envir = palette_cache, inherits = FALSE)) {
    return(get(column_name, envir = palette_cache, inherits = FALSE))
  }
  used <- unlist(as.list(palette_cache), use.names = FALSE)
  available <- setdiff(qualitative_palette_names, used)
  if (length(available) == 0) {
    available <- qualitative_palette_names
  }
  idx <- (sum(utf8ToInt(column_name)) %% length(available)) + 1
  selected <- available[[idx]]
  assign(column_name, selected, envir = palette_cache)
  palette_assignment_rows[[length(palette_assignment_rows) + 1]] <<- data.frame(
    column = column_name,
    palette = selected,
    stringsAsFactors = FALSE
  )
  selected
}

categorical_palette <- function(levels_vec, palette_name = NULL) {
  levels_vec <- unique(as.character(levels_vec))
  levels_vec <- levels_vec[nzchar(levels_vec)]
  if (length(levels_vec) == 0) {
    return(c())
  }
  brewer_info <- RColorBrewer::brewer.pal.info
  if (is.null(palette_name) || !(palette_name %in% rownames(brewer_info))) {
    qualitative <- rownames(brewer_info[brewer_info$category == "qual", , drop = FALSE])
    palette_name <- qualitative[which.max(brewer_info[qualitative, "maxcolors"])]
  }
  base_n <- brewer_info[palette_name, "maxcolors"]
  base_palette <- RColorBrewer::brewer.pal(max(3, min(base_n, length(levels_vec))), palette_name)
  if (length(levels_vec) > length(base_palette)) {
    base_palette <- grDevices::colorRampPalette(base_palette)(length(levels_vec))
  } else {
    base_palette <- base_palette[seq_len(length(levels_vec))]
  }
  stats::setNames(base_palette, levels_vec)
}

gradient_palette <- function(n) {
  n <- max(3, as.integer(n))
  base_steps <- max(9, min(11, n))
  base_palette <- RColorBrewer::brewer.pal(base_steps, "RdBu")
  base_palette <- rev(base_palette)
  if (n > length(base_palette)) {
    return(grDevices::colorRampPalette(base_palette)(n))
  }
  stats::setNames(base_palette[seq_len(n)], NULL)
}

row_zscore <- function(mat) {
  scaled <- t(scale(t(mat)))
  scaled[is.na(scaled)] <- 0
  scaled
}

strip_ensembl_version <- function(ids) {
  sub("\\..*$", "", as.character(ids))
}

map_gene_symbols <- function(gene_ids, fallback_to_ids = TRUE) {
  gene_ids <- as.character(gene_ids)
  ids_no_version <- strip_ensembl_version(gene_ids)
  symbols <- rep(NA_character_, length(ids_no_version))

  has_annotationdbi <- requireNamespace("AnnotationDbi", quietly = TRUE)
  if (has_annotationdbi) {
    is_human <- grepl("^ENSG", ids_no_version)
    is_mouse <- grepl("^ENSMUSG", ids_no_version)

    if (any(is_human) && requireNamespace("org.Hs.eg.db", quietly = TRUE)) {
      mapped <- tryCatch(
        AnnotationDbi::mapIds(
          org.Hs.eg.db::org.Hs.eg.db,
          keys = unique(ids_no_version[is_human]),
          column = "SYMBOL",
          keytype = "ENSEMBL",
          multiVals = "first"
        ),
        error = function(e) {
          message("Symbol mapping warning (human): ", conditionMessage(e))
          stats::setNames(rep(NA_character_, length(unique(ids_no_version[is_human]))), unique(ids_no_version[is_human]))
        }
      )
      symbols[is_human] <- unname(mapped[ids_no_version[is_human]])
    }

    if (any(is_mouse) && requireNamespace("org.Mm.eg.db", quietly = TRUE)) {
      mapped <- tryCatch(
        AnnotationDbi::mapIds(
          org.Mm.eg.db::org.Mm.eg.db,
          keys = unique(ids_no_version[is_mouse]),
          column = "SYMBOL",
          keytype = "ENSEMBL",
          multiVals = "first"
        ),
        error = function(e) {
          message("Symbol mapping warning (mouse): ", conditionMessage(e))
          stats::setNames(rep(NA_character_, length(unique(ids_no_version[is_mouse]))), unique(ids_no_version[is_mouse]))
        }
      )
      symbols[is_mouse] <- unname(mapped[ids_no_version[is_mouse]])
    }
  }

  missing <- is.na(symbols) | !nzchar(symbols)
  if (fallback_to_ids) {
    symbols[missing] <- ids_no_version[missing]
  } else {
    symbols[missing] <- NA_character_
  }
  symbols
}

counts_df <- utils::read.delim(counts_path, check.names = FALSE, stringsAsFactors = FALSE)
metadata_df <- utils::read.delim(metadata_path, check.names = FALSE, stringsAsFactors = FALSE)

if (ncol(counts_df) < 2) {
  stop("Count table must contain a gene-id column and at least one sample column.")
}

if (!("sample_id" %in% colnames(metadata_df))) {
  stop("Derived metadata must contain sample_id.")
}

sample_columns <- colnames(counts_df)[-1]
if (all(metadata_df$sample_id %in% sample_columns)) {
  match_key <- "sample_id"
} else if ("filename_key" %in% colnames(metadata_df) && all(metadata_df$filename_key %in% sample_columns)) {
  match_key <- "filename_key"
} else {
  stop("Could not match count table sample columns to metadata sample_id or filename_key.")
}

metadata_df <- metadata_df[match(sample_columns, metadata_df[[match_key]]), , drop = FALSE]
if (any(is.na(metadata_df[[match_key]]))) {
  stop("Metadata matching produced missing rows.")
}

count_matrix <- as.matrix(counts_df[, sample_columns, drop = FALSE])
rownames(count_matrix) <- counts_df[[1]]
mode(count_matrix) <- "numeric"
non_integer <- abs(count_matrix - round(count_matrix)) > 1e-8
if (any(non_integer, na.rm = TRUE)) {
  stop("Count table contains non-integer values. DESeq2 requires raw integer counts.")
}
storage.mode(count_matrix) <- "integer"
genes_before_filter <- nrow(count_matrix)

col_data <- metadata_df
rownames(col_data) <- sample_columns

if (filtering_enabled && filtering_method == "min_count_samples") {
  keep <- rowSums(count_matrix >= filtering_min_count) >= filtering_min_samples
  count_matrix <- count_matrix[keep, , drop = FALSE]
}
genes_after_filter <- nrow(count_matrix)

design_formula <- stats::as.formula(design_formula_text)
dds <- DESeq2::DESeqDataSetFromMatrix(
  countData = count_matrix,
  colData = col_data,
  design = design_formula
)
dds <- DESeq2::DESeq(dds, fitType = deseq_fit_type, sfType = deseq_sf_type, parallel = deseq_parallel)
vst_obj <- DESeq2::vst(dds, blind = vst_blind)

all_gene_ids <- rownames(dds)
all_gene_ids_no_version <- strip_ensembl_version(all_gene_ids)
all_gene_symbols <- map_gene_symbols(all_gene_ids, fallback_to_ids = FALSE)
symbol_lookup <- stats::setNames(all_gene_symbols, all_gene_ids)
symbol_lookup_no_version <- stats::setNames(all_gene_symbols, all_gene_ids_no_version)

ensembl_like <- grepl("^ENS(?:MUSG|G)[0-9]+$", all_gene_ids_no_version)
ensembl_like_fraction <- mean(ensembl_like)
mapped_symbol_fraction <- mean(!is.na(all_gene_symbols) & nzchar(all_gene_symbols))
unmapped_gene_ids <- all_gene_ids[is.na(all_gene_symbols) | !nzchar(all_gene_symbols)]
mapping_status <- "ok"
mapping_message <- "Gene symbol mapping succeeded for most genes."
if (length(unmapped_gene_ids) > 0) {
  mapping_status <- "fallback_to_ensembl"
  mapping_message <- paste0(
    "Falling back to Ensembl IDs for ", length(unmapped_gene_ids),
    " genes without mapped symbols."
  )
}
if (is.finite(ensembl_like_fraction) && is.finite(mapped_symbol_fraction) &&
    ensembl_like_fraction >= 0.5 && mapped_symbol_fraction < 0.05) {
  mapping_status <- "fallback_likely_missing_annotation_packages"
  mapping_message <- paste0(
    "Symbol mapping is very low for Ensembl-like IDs (mapped fraction=",
    round(mapped_symbol_fraction, 4),
    "). Falling back to Ensembl IDs. ",
    "Likely cause: missing org.Hs.eg.db/org.Mm.eg.db and/or AnnotationDbi packages."
  )
}
message(mapping_message)

symbols_for_ids <- function(gene_ids, fallback_to_ids = FALSE) {
  gid <- as.character(gene_ids)
  gid_no_version <- strip_ensembl_version(gid)
  symbols <- unname(symbol_lookup[gid])
  missing <- is.na(symbols) | !nzchar(symbols)
  if (any(missing)) {
    symbols[missing] <- unname(symbol_lookup_no_version[gid_no_version[missing]])
  }
  missing <- is.na(symbols) | !nzchar(symbols)
  if (any(missing)) {
    symbols_missing <- tryCatch(
      map_gene_symbols(gid[missing], fallback_to_ids = fallback_to_ids),
      error = function(e) {
        message("Symbol remap fallback warning: ", conditionMessage(e))
        rep(NA_character_, sum(missing))
      }
    )
    symbols[missing] <- symbols_missing
  }
  if (fallback_to_ids) {
    missing <- is.na(symbols) | !nzchar(symbols)
    symbols[missing] <- strip_ensembl_version(gid[missing])
  }
  symbols
}

detect_species_from_gene_ids <- function(gene_ids) {
  ids_no_version <- strip_ensembl_version(gene_ids)
  frac_human <- mean(grepl("^ENSG[0-9]+$", ids_no_version))
  frac_mouse <- mean(grepl("^ENSMUSG[0-9]+$", ids_no_version))
  if (is.finite(frac_human) && frac_human >= 0.5) {
    return(list(
      species_label = "human",
      msig_species = "Homo sapiens",
      orgdb = if (requireNamespace("org.Hs.eg.db", quietly = TRUE)) org.Hs.eg.db::org.Hs.eg.db else NULL
    ))
  }
  if (is.finite(frac_mouse) && frac_mouse >= 0.5) {
    return(list(
      species_label = "mouse",
      msig_species = "Mus musculus",
      orgdb = if (requireNamespace("org.Mm.eg.db", quietly = TRUE)) org.Mm.eg.db::org.Mm.eg.db else NULL
    ))
  }
  list(species_label = "unknown", msig_species = NULL, orgdb = NULL)
}

is_valid_symbol <- function(x) {
  x <- as.character(x)
  !is.na(x) & nzchar(x) & !grepl("^ENS(?:MUSG|G)[0-9]+$", strip_ensembl_version(x))
}

deduplicate_ranked_vector <- function(gene_stats) {
  gene_stats <- gene_stats[is.finite(gene_stats)]
  if (length(gene_stats) == 0) {
    return(gene_stats)
  }
  split_vals <- split(as.numeric(gene_stats), names(gene_stats))
  collapsed <- vapply(
    split_vals,
    function(vals) vals[which.max(abs(vals))],
    numeric(1)
  )
  sort(collapsed, decreasing = TRUE)
}

save_enrichment_plot <- function(plot_obj, out_path, width = 11, height = 8) {
  if (is.null(plot_obj)) {
    return(FALSE)
  }
  tryCatch({
    ggplot2::ggsave(filename = out_path, plot = plot_obj, width = width, height = height)
    TRUE
  }, error = function(e) {
    message("Could not save plot ", out_path, ": ", conditionMessage(e))
    FALSE
  })
}

safe_cp_result_table <- function(cp_obj) {
  if (is.null(cp_obj)) {
    return(NULL)
  }
  df <- tryCatch(as.data.frame(cp_obj), error = function(e) NULL)
  if (is.null(df) || nrow(df) == 0) {
    return(NULL)
  }
  df
}

aggregate_symbol_matrix <- function(mat, symbols) {
  keep <- !is.na(symbols) & nzchar(symbols)
  mat <- mat[keep, , drop = FALSE]
  symbols <- symbols[keep]
  keep2 <- !duplicated(cbind(symbols, rownames(mat)))
  mat <- mat[keep2, , drop = FALSE]
  symbols <- symbols[keep2]
  if (nrow(mat) == 0) {
    return(mat)
  }
  summed <- rowsum(mat, group = symbols, reorder = FALSE)
  symbol_counts <- table(symbols)
  denom <- as.numeric(symbol_counts[rownames(summed)])
  denom[!is.finite(denom) | denom <= 0] <- 1
  swept <- sweep(summed, 1, denom, "/")
  swept
}

decoupler_to_matrix <- function(activity_df) {
  needed <- c("condition", "source", "score")
  if (!all(needed %in% colnames(activity_df))) {
    return(NULL)
  }
  xtabs(score ~ condition + source, data = activity_df)
}

plot_decoupler_bar <- function(activity_df, out_file, title, top_n = 25) {
  needed <- c("source", "score")
  if (!all(needed %in% colnames(activity_df))) {
    return(NULL)
  }
  plot_df <- activity_df[, needed, drop = FALSE]
  plot_df <- plot_df[is.finite(plot_df$score), , drop = FALSE]
  if (nrow(plot_df) == 0) {
    return(NULL)
  }
  plot_df <- plot_df[order(-abs(plot_df$score)), , drop = FALSE]
  plot_df <- head(plot_df, top_n)
  cols <- rev(RColorBrewer::brewer.pal(n = 11, name = "RdBu")[c(2, 10)])
  p <- ggplot2::ggplot(
    plot_df,
    ggplot2::aes(x = stats::reorder(source, score), y = score, fill = score)
  ) +
    ggplot2::geom_col(color = "black") +
    ggplot2::coord_flip() +
    ggplot2::scale_fill_gradient2(low = cols[1], mid = "whitesmoke", high = cols[2], midpoint = 0) +
    ggplot2::theme_light() +
    ggplot2::theme(panel.grid = ggplot2::element_blank()) +
    ggplot2::xlab(NULL) +
    ggplot2::ylab("Activity score") +
    ggplot2::ggtitle(title)
  save_enrichment_plot(p, out_file, width = 10, height = 8)
}

plot_decoupler_heatmap <- function(activity_mat, out_file, title, top_features = 25) {
  if (is.null(activity_mat) || nrow(activity_mat) < 2 || ncol(activity_mat) < 2) {
    return(NULL)
  }
  feature_sd <- apply(activity_mat, 2, stats::sd, na.rm = TRUE)
  feature_sd[!is.finite(feature_sd)] <- 0
  keep_cols <- names(sort(feature_sd, decreasing = TRUE))[seq_len(min(top_features, ncol(activity_mat)))]
  mat <- activity_mat[, keep_cols, drop = FALSE]
  mat <- scale(mat)
  mat[is.na(mat)] <- 0
  cols <- rev(RColorBrewer::brewer.pal(n = 11, name = "RdBu"))
  cols <- grDevices::colorRampPalette(cols)(100)
  breaks <- c(seq(-2, 0, length.out = 51), seq(0.05, 2, length.out = 49))
  grDevices::pdf(out_file, width = 12, height = 8)
  pheatmap::pheatmap(
    mat = mat,
    color = cols,
    breaks = breaks,
    border_color = "white",
    main = title
  )
  grDevices::dev.off()
}

enrichment_rows <- list()
cp_available <- enrichment_enabled && enrichment_cp_enabled &&
  requireNamespace("clusterProfiler", quietly = TRUE) &&
  requireNamespace("enrichplot", quietly = TRUE)
if (enrichment_enabled && enrichment_cp_enabled && !cp_available) {
  message("Enrichment requested but clusterProfiler/enrichplot are not available. Skipping enrichment.")
}

decoupler_available <- enrichment_enabled && decoupler_enabled &&
  requireNamespace("decoupleR", quietly = TRUE)
if (enrichment_enabled && decoupler_enabled && !decoupler_available) {
  message("Decoupler enrichment requested but decoupleR is not available. Skipping decoupler outputs.")
}

species_info <- detect_species_from_gene_ids(rownames(dds))
msig_term2gene <- list()
if (cp_available && enrichment_enabled && enrichment_cp_enabled) {
  if (!requireNamespace("msigdbr", quietly = TRUE) || is.null(species_info$msig_species)) {
    message("MSigDB enrichment requested but msigdbr and/or species detection is unavailable. MSigDB enrichment will be skipped.")
  } else if (!is.list(enrichment_msigdb_sets) || length(enrichment_msigdb_sets) == 0) {
    message("No MSigDB sets configured for clusterProfiler enrichment. Skipping clusterProfiler enrichment.")
  } else {
    for (set_cfg in enrichment_msigdb_sets) {
      set_name <- as.character(set_cfg$name)
      set_category <- toupper(as.character(set_cfg$category))
      set_subcategory <- set_cfg$subcategory
      if (length(set_name) == 0 || !nzchar(set_name) || length(set_category) == 0 || !nzchar(set_category)) {
        next
      }
      msig_tbl <- tryCatch(
        {
          if (is.null(set_subcategory) || is.na(set_subcategory) || !nzchar(as.character(set_subcategory))) {
            msigdbr::msigdbr(species = species_info$msig_species, category = set_category)
          } else {
            msigdbr::msigdbr(
              species = species_info$msig_species,
              category = set_category,
              subcategory = as.character(set_subcategory)
            )
          }
        },
        error = function(e) {
          message(
            "msigdbr loading failed for set '", set_name, "' (", set_category,
            if (!is.null(set_subcategory) && !is.na(set_subcategory) && nzchar(as.character(set_subcategory))) {
              paste0(":", as.character(set_subcategory))
            } else {
              ""
            },
            "): ", conditionMessage(e)
          )
          NULL
        }
      )
      if (is.null(msig_tbl) || nrow(msig_tbl) == 0) {
        next
      }
      term2gene <- unique(msig_tbl[, c("gs_name", "gene_symbol"), drop = FALSE])
      colnames(term2gene) <- c("term", "gene")
      msig_term2gene[[set_name]] <- term2gene
    }
    if (length(msig_term2gene) == 0) {
      message("None of the configured MSigDB sets could be loaded. Skipping clusterProfiler enrichment.")
    }
  }
}

design_terms <- attr(stats::terms(design_formula), "term.labels")
annotation_columns <- unique(unlist(strsplit(design_terms, ":", fixed = TRUE)))
annotation_columns <- annotation_columns[nzchar(annotation_columns)]
auto_categorical_columns <- colnames(col_data)[
  vapply(colnames(col_data), function(x) is_categorical_grouping_column(col_data, x), logical(1))
]
annotation_columns <- unique(c(
  annotation_columns,
