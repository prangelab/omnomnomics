if (!is.null(cooks_mat)) {
  cooks_sample_summary <- data.frame(
    sample = colnames(cooks_mat),
    genes_cooks_gt_10 = colSums(cooks_mat > 10, na.rm = TRUE),
    max_cooks = apply(cooks_mat, 2, max, na.rm = TRUE),
    q99_cooks = apply(cooks_mat, 2, stats::quantile, probs = 0.99, na.rm = TRUE),
    stringsAsFactors = FALSE
  )
  utils::write.table(
    cooks_sample_summary,
    file = file.path(qc_dir, "cooks_distance_sample_summary.tsv"),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )

  cooks_global <- data.frame(
    metric = c("num_values", "num_gt_1", "num_gt_5", "num_gt_10", "global_max", "global_q99"),
    value = c(
      sum(is.finite(cooks_mat)),
      sum(cooks_mat > 1, na.rm = TRUE),
      sum(cooks_mat > 5, na.rm = TRUE),
      sum(cooks_mat > 10, na.rm = TRUE),
      max(cooks_mat, na.rm = TRUE),
      stats::quantile(cooks_mat, probs = 0.99, na.rm = TRUE)
    ),
    stringsAsFactors = FALSE
  )
  utils::write.table(
