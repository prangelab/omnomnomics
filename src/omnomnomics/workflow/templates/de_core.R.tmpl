add_palette_rows <- function(column_name) {
  if (!(column_name %in% colnames(col_data))) {
    return()
  }
  column_values <- as.character(col_data[[column_name]])
  levels_vec <- unique(column_values)
  levels_vec <- levels_vec[!is.na(levels_vec) & nzchar(levels_vec)]
  if (length(levels_vec) < 2) {
    return()
  }
  pal <- categorical_palette(
    levels_vec,
    palette_name = palette_name_for_column(column_name)
  )
  if (length(pal) == 0) {
    return()
  }
  palette_rows[[length(palette_rows) + 1]] <<- data.frame(
    column = column_name,
    level = names(pal),
    color = as.vector(pal),
    stringsAsFactors = FALSE
  )
}

