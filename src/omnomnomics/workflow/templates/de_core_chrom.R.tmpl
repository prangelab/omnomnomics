plot_decoupler_bar <- function(activity_df, out_file, title, top_n = 25) {
  needed <- c("source", "score")
  if (!all(needed %in% colnames(activity_df))) {
    return(NULL)
  }
  plot_df <- activity_df[, needed, drop = FALSE]
  plot_df <- plot_df[is.finite(plot_df$score), , drop = FALSE]
  if (nrow(plot_df) == 0) {
    return(NULL)
  }
  plot_df <- plot_df[order(-abs(plot_df$score)), , drop = FALSE]
  plot_df <- head(plot_df, top_n)
  cols <- rev(RColorBrewer::brewer.pal(n = 11, name = "RdBu")[c(2, 10)])
  p <- ggplot2::ggplot(
    plot_df,
    ggplot2::aes(x = stats::reorder(source, score), y = score, fill = score)
  ) +
    ggplot2::geom_col(color = "black") +
    ggplot2::coord_flip() +
    ggplot2::scale_fill_gradient2(low = cols[1], mid = "whitesmoke", high = cols[2], midpoint = 0) +
    ggplot2::theme_light() +
    ggplot2::theme(panel.grid = ggplot2::element_blank()) +
    ggplot2::xlab(NULL) +
    ggplot2::ylab("Activity score") +
    ggplot2::ggtitle(title)
  save_enrichment_plot(p, out_file, width = 10, height = 8)
}

plot_decoupler_heatmap <- function(activity_mat, out_file, title, top_features = 25) {
  if (is.null(activity_mat) || nrow(activity_mat) < 2 || ncol(activity_mat) < 2) {
    return(NULL)
  }
  feature_sd <- apply(activity_mat, 2, stats::sd, na.rm = TRUE)
  feature_sd[!is.finite(feature_sd)] <- 0
  keep_cols <- names(sort(feature_sd, decreasing = TRUE))[seq_len(min(top_features, ncol(activity_mat)))]
  mat <- activity_mat[, keep_cols, drop = FALSE]
  mat <- scale(mat)
  mat[is.na(mat)] <- 0
  cols <- rev(RColorBrewer::brewer.pal(n = 11, name = "RdBu"))
  cols <- grDevices::colorRampPalette(cols)(100)
  breaks <- c(seq(-2, 0, length.out = 51), seq(0.05, 2, length.out = 49))
  grDevices::pdf(out_file, width = 12, height = 8)
  pheatmap::pheatmap(
    mat = mat,
    color = cols,
    breaks = breaks,
    border_color = "white",
    main = title
  )
  grDevices::dev.off()
}

