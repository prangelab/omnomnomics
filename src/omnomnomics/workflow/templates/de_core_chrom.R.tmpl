build_rank_table <- function(df, score_col, id_col = "gene_symbol", fallback_id_col = "gene_id") {
  if (!(score_col %in% colnames(df))) {
    return(NULL)
  }
  scores <- suppressWarnings(as.numeric(df[[score_col]]))
  ids <- as.character(df[[id_col]])
  if (!(fallback_id_col %in% colnames(df))) {
    fallback_ids <- rep(NA_character_, nrow(df))
  } else {
    fallback_ids <- strip_ensembl_version(as.character(df[[fallback_id_col]]))
  }
  use_ids <- ids
  bad <- is.na(use_ids) | !nzchar(use_ids)
  use_ids[bad] <- fallback_ids[bad]
  keep <- !is.na(use_ids) & nzchar(use_ids) & is.finite(scores)
  if (!any(keep)) {
    return(NULL)
  }
  rank_df <- data.frame(
    feature = use_ids[keep],
    score = scores[keep],
    stringsAsFactors = FALSE
  )
  rank_df <- rank_df[order(abs(rank_df$score), decreasing = TRUE), , drop = FALSE]
  rank_df <- rank_df[!duplicated(rank_df$feature), , drop = FALSE]
  rank_df <- rank_df[order(rank_df$score, decreasing = TRUE), , drop = FALSE]
  rank_df
}

read_gmt_term2gene <- function(gmt_path) {
  lines <- readLines(gmt_path, warn = FALSE)
  lines <- lines[nzchar(lines)]
  if (length(lines) == 0) {
    return(data.frame(term = character(0), gene = character(0), stringsAsFactors = FALSE))
  }
  rows <- vector("list", length(lines))
  out_idx <- 0L
  for (line in lines) {
    parts <- strsplit(line, "\t", fixed = TRUE)[[1]]
    if (length(parts) < 3) {
      next
    }
    term <- as.character(parts[[1]])
    genes <- unique(as.character(parts[-c(1, 2)]))
    genes <- genes[nzchar(genes)]
    if (!nzchar(term) || length(genes) == 0) {
      next
    }
    out_idx <- out_idx + 1L
    rows[[out_idx]] <- data.frame(
      term = rep(term, length(genes)),
      gene = genes,
      stringsAsFactors = FALSE
    )
  }
  if (out_idx == 0L) {
    return(data.frame(term = character(0), gene = character(0), stringsAsFactors = FALSE))
  }
  do.call(rbind, rows[seq_len(out_idx)])
}

normalize_term_tokens <- function(x) {
  x <- tolower(as.character(x))
  x <- gsub("[^a-z0-9 ]+", " ", x)
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)
  if (!nzchar(x)) {
    return(character(0))
  }
  toks <- unique(strsplit(x, " ", fixed = TRUE)[[1]])
  toks <- toks[nzchar(toks)]
  # Remove low-information tokens commonly repeated across pathway names.
  toks <- toks[!(toks %in% c("pathway", "signaling", "process", "response", "regulation"))]
  toks
}

reduce_redundant_terms <- function(df, term_col = "term", score_col = "score", max_terms = 12, jaccard_cutoff = 0.6) {
  if (nrow(df) == 0) {
    return(df)
  }
  df <- df[order(df[[score_col]], decreasing = TRUE), , drop = FALSE]
  keep_idx <- integer(0)
  kept_tokens <- list()
  for (i in seq_len(nrow(df))) {
    term_tokens <- normalize_term_tokens(df[[term_col]][i])
    is_redundant <- FALSE
    if (length(term_tokens) > 0 && length(kept_tokens) > 0) {
      for (tok in kept_tokens) {
        inter <- length(intersect(term_tokens, tok))
        union <- length(union(term_tokens, tok))
        jaccard <- if (union > 0) inter / union else 0
        if (jaccard >= jaccard_cutoff) {
          is_redundant <- TRUE
          break
        }
      }
    }
    if (!is_redundant) {
      keep_idx <- c(keep_idx, i)
      kept_tokens[[length(kept_tokens) + 1]] <- term_tokens
    }
    if (length(keep_idx) >= max_terms) {
      break
    }
  }
  if (length(keep_idx) == 0) {
    return(head(df, min(max_terms, nrow(df))))
  }
  df[keep_idx, , drop = FALSE]
}

resolve_featurecounts_summary_path <- function(counts_table_path) {
  candidate <- sub("\\.raw_read_quant\\.table\\.txt$", ".featureCounts.summary.txt", counts_table_path)
  if (!identical(candidate, counts_table_path) && file.exists(candidate)) {
    return(candidate)
  }
  search_dir <- dirname(counts_table_path)
  candidates <- list.files(
    search_dir,
    pattern = "\\.featureCounts\\.summary\\.txt$",
    full.names = TRUE
  )
  if (length(candidates) == 1) {
    return(candidates[[1]])
  }
  if (length(candidates) > 1) {
    ordered <- candidates[order(file.info(candidates)$mtime, decreasing = TRUE)]
    return(ordered[[1]])
  }
  NA_character_
}

