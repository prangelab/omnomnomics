      region_short <- region_short_from_peak_region(enrich_df$peak_region[[i]])
      linked <- as.character(enrich_df$linked_gene_symbol[[i]])
      if (is.na(linked) || !nzchar(linked) || identical(linked, "NA")) {
        linked <- as.character(enrich_df$gene_symbol[[i]])
      }
      if (is.na(linked) || !nzchar(linked) || identical(linked, "NA")) {
        linked <- "NA"
      }
      paste(coord, region_short, linked, sep = "-")
    },
    character(1)
  )

  res_df$feature_label <- enrich_df$feature_label[match(res_df$gene_id, enrich_df$gene_id)]
  res_df$peak_region <- enrich_df$peak_region[match(res_df$gene_id, enrich_df$gene_id)]
  res_df$assigned_genes <- enrich_df$assigned_genes[match(res_df$gene_id, enrich_df$gene_id)]
  res_df$nearest_gene <- enrich_df$nearest_gene[match(res_df$gene_id, enrich_df$gene_id)]
  res_df$linked_gene_symbol <- enrich_df$linked_gene_symbol[match(res_df$gene_id, enrich_df$gene_id)]
  res_df$link_mode <- enrich_df$link_mode[match(res_df$gene_id, enrich_df$gene_id)]
  missing_feature_labels <- is.na(res_df$feature_label) | !nzchar(res_df$feature_label)
  res_df$feature_label[missing_feature_labels] <- res_df$gene_id[missing_feature_labels]
  missing_peak_region <- is.na(res_df$peak_region) | !nzchar(res_df$peak_region)
  res_df$peak_region[missing_peak_region] <- "NA"
  missing_link_mode <- is.na(res_df$link_mode) | !nzchar(res_df$link_mode)
