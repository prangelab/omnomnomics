    )

    run_ora_term2gene <- function(gene_symbols, term2gene_tbl, set_name, direction_label, universe_symbols, output_dir = cp_dir, split_name = "all") {
      if (length(gene_symbols) < 2 || is.null(term2gene_tbl) || nrow(term2gene_tbl) == 0) {
        return(NULL)
      }
      ora_obj <- tryCatch(
        clusterProfiler::enricher(
          gene = gene_symbols,
          universe = universe_symbols,
          TERM2GENE = term2gene_tbl,
          pvalueCutoff = enrichment_pvalue_cutoff,
          qvalueCutoff = enrichment_qvalue_cutoff,
          minGSSize = enrichment_min_gs_size,
          maxGSSize = enrichment_max_gs_size
        ),
        error = function(e) {
          message("ORA failed for ", contrast_label, " [", set_name, ", ", direction_label, "]: ", conditionMessage(e))
          NULL
        }
      )
      ora_tbl <- safe_cp_result_table(ora_obj)
      if (is.null(ora_tbl)) {
        return(NULL)
      }
      utils::write.table(
        ora_tbl,
        file = file.path(output_dir, paste0(contrast_label, ".", set_name, ".", direction_label, ".ORA.tsv")),
        sep = "\t",
        quote = FALSE,
        row.names = FALSE
