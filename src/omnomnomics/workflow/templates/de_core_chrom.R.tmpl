symbols_for_ids <- function(gene_ids, fallback_to_ids = FALSE) {
  gid <- as.character(gene_ids)
  gid_no_version <- strip_ensembl_version(gid)
  symbols <- unname(symbol_lookup[gid])
  missing <- is.na(symbols) | !nzchar(symbols)
  if (any(missing)) {
    symbols[missing] <- unname(symbol_lookup_no_version[gid_no_version[missing]])
  }
  missing <- is.na(symbols) | !nzchar(symbols)
  if (any(missing)) {
    symbols_missing <- tryCatch(
      map_gene_symbols(gid[missing], fallback_to_ids = fallback_to_ids),
      error = function(e) {
        message("Symbol remap fallback warning: ", conditionMessage(e))
        rep(NA_character_, sum(missing))
      }
    )
    symbols[missing] <- symbols_missing
  }
  if (fallback_to_ids) {
    missing <- is.na(symbols) | !nzchar(symbols)
    symbols[missing] <- strip_ensembl_version(gid[missing])
  }
  symbols
}

detect_species_from_gene_ids <- function(gene_ids) {
  ids_no_version <- strip_ensembl_version(gene_ids)
  frac_human <- mean(grepl("^ENSG[0-9]+$", ids_no_version))
  frac_mouse <- mean(grepl("^ENSMUSG[0-9]+$", ids_no_version))
  if (is.finite(frac_human) && frac_human >= 0.5) {
    return(list(
      species_label = "human",
      msig_species = "Homo sapiens",
      orgdb = if (requireNamespace("org.Hs.eg.db", quietly = TRUE)) org.Hs.eg.db::org.Hs.eg.db else NULL
    ))
  }
  if (is.finite(frac_mouse) && frac_mouse >= 0.5) {
    return(list(
      species_label = "mouse",
      msig_species = "Mus musculus",
      orgdb = if (requireNamespace("org.Mm.eg.db", quietly = TRUE)) org.Mm.eg.db::org.Mm.eg.db else NULL
    ))
  }
  list(species_label = "unknown", msig_species = NULL, orgdb = NULL)
}

detect_species_from_context <- function(gene_ids, genome = NA_character_) {
  genome_norm <- tolower(as.character(genome))
  genome_norm <- genome_norm[!is.na(genome_norm) & nzchar(genome_norm)]
  if (length(genome_norm) > 0) {
    genome_norm <- genome_norm[[1]]
    if (grepl("^(grch|hg|human|homo)", genome_norm)) {
      return(list(
        species_label = "human",
        msig_species = "Homo sapiens",
        orgdb = if (requireNamespace("org.Hs.eg.db", quietly = TRUE)) org.Hs.eg.db::org.Hs.eg.db else NULL
      ))
    }
    if (grepl("^(grcm|mm|mouse|mus)", genome_norm)) {
      return(list(
        species_label = "mouse",
        msig_species = "Mus musculus",
        orgdb = if (requireNamespace("org.Mm.eg.db", quietly = TRUE)) org.Mm.eg.db::org.Mm.eg.db else NULL
      ))
    }
  }
  detect_species_from_gene_ids(gene_ids)
}

