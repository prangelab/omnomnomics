fc_summary_path <- resolve_featurecounts_summary_path(counts_path)
if (!is.na(fc_summary_path) && file.exists(fc_summary_path)) {
  message("Using featureCounts summary for sample QC: ", fc_summary_path)
  fc_summary <- tryCatch(
    utils::read.delim(fc_summary_path, check.names = FALSE, stringsAsFactors = FALSE, row.names = 1),
    error = function(e) NULL
  )
  if (!is.null(fc_summary) && ncol(fc_summary) > 0) {
    fc_cols <- colnames(fc_summary)
    fc_totals <- colSums(fc_summary, na.rm = TRUE)
    assigned_row_name <- c("Assigned", "assigned")
    assigned_row_name <- assigned_row_name[assigned_row_name %in% rownames(fc_summary)]
    if (length(assigned_row_name) > 0) {
      fc_assigned <- as.numeric(fc_summary[assigned_row_name[[1]], , drop = TRUE])
    } else {
      fc_assigned <- rep(NA_real_, length(fc_cols))
    }
    fc_assigned_pct <- 100 * fc_assigned / pmax(fc_totals, 1)
    sample_qc$featurecounts_total <- as.numeric(fc_totals[match(sample_qc$sample, fc_cols)])
    sample_qc$featurecounts_assigned <- as.numeric(fc_assigned[match(sample_qc$sample, fc_cols)])
    sample_qc$featurecounts_assigned_pct <- as.numeric(fc_assigned_pct[match(sample_qc$sample, fc_cols)])
  } else {
    sample_qc$featurecounts_total <- NA_real_
    sample_qc$featurecounts_assigned <- NA_real_
    sample_qc$featurecounts_assigned_pct <- NA_real_
  }
} else {
  message("No featureCounts summary file detected for sample QC. Assignment metrics will be NA.")
  sample_qc$featurecounts_total <- NA_real_
  sample_qc$featurecounts_assigned <- NA_real_
  sample_qc$featurecounts_assigned_pct <- NA_real_
}

