if (qc_enabled) {
  pca_color_candidates <- unique(c(de_columns_resolved, pca_color_by, auto_categorical_columns))
  pca_color_by_use <- select_nonredundant_metadata_columns(
    pca_color_candidates,
    col_data,
    max_columns = 1
  )
  if (length(pca_color_by_use) == 0) {
    pca_color_by_use <- select_nonredundant_metadata_columns(
      auto_categorical_columns,
      col_data,
      max_columns = 1
    )
  }
  pca_shape_by_values_use <- select_nonredundant_metadata_columns(
    pca_shape_by_values,
    col_data,
    max_columns = 1,
    existing_columns = pca_color_by_use
  )

  if (distance_plot_enabled) {
    dist_mat <- as.matrix(stats::dist(t(SummarizedExperiment::assay(vst_obj))))
    label_columns <- informative_annotation_columns
    label_columns <- label_columns[seq_len(min(3, length(label_columns)))]
    if (length(label_columns) > 0) {
      sample_labels <- apply(
        cbind(sample = rownames(col_data), col_data[, label_columns, drop = FALSE]),
        1,
        function(x) paste(x, collapse = " : ")
      )
      rownames(dist_mat) <- sample_labels
      colnames(dist_mat) <- sample_labels
    }
    grDevices::pdf(file.path(qc_dir, paste0(top_variable_feature_stem, ".distance_plot.pdf")), width = 10, height = 10)
    pheatmap::pheatmap(dist_mat, main = paste("Sample distance (", feature_label_plural, ")", sep = ""))
    grDevices::dev.off()
  }

  if (variable_heatmap_enabled) {
    top_idx <- head(order(-matrixStats::rowVars(SummarizedExperiment::assay(vst_obj))), top_variable_genes)
    top_mat <- SummarizedExperiment::assay(vst_obj)[top_idx, , drop = FALSE]
    top_mat <- row_zscore(top_mat)
    keep_rows <- is.finite(rowMeans(top_mat))
    top_mat <- top_mat[keep_rows, , drop = FALSE]
    if (nrow(top_mat) > 1) {
      k <- min(5, nrow(top_mat))
      km <- stats::kmeans(top_mat, centers = k, iter.max = 20, nstart = 20)
      top_mat <- top_mat[names(sort(km$cluster)), , drop = FALSE]
    }
    hm_colors <- gradient_palette(255)
    max_abs <- max(abs(top_mat), na.rm = TRUE)
    if (!is.finite(max_abs) || max_abs <= 0) {
      max_abs <- 1
    }
    hm_breaks <- seq(-max_abs, max_abs, length.out = 256)
    top_annotation <- prepare_pheatmap_annotations(annotation_df_informative, annotation_colors_informative)
    grDevices::pdf(file.path(qc_dir, paste0(top_variable_feature_stem, ".kmeans_heatmap.pdf")), width = 12, height = 10)
    pheatmap::pheatmap(
      top_mat,
      cluster_rows = FALSE,
      cluster_cols = TRUE,
      breaks = hm_breaks,
      color = hm_colors,
      annotation_col = top_annotation$annotation_df,
      annotation_colors = top_annotation$annotation_colors,
      show_rownames = FALSE,
      show_colnames = TRUE,
      main = paste("Top variable", feature_label_plural)
    )
    grDevices::dev.off()
  }

  if (pca_enabled) {
    pca <- stats::prcomp(t(SummarizedExperiment::assay(vst_obj)))
    pca_df <- as.data.frame(pca$x)
    pca_df$sample <- rownames(pca_df)
    for (column_name in colnames(col_data)) {
      pca_df[[column_name]] <- col_data[[column_name]]
    }
    pct <- round(100 * (pca$sdev^2 / sum(pca$sdev^2)), 2)
    pca_var_df <- data.frame(
      pc = paste0("PC", seq_along(pca$sdev)),
      variance_explained_pct = as.numeric(100 * (pca$sdev^2 / sum(pca$sdev^2))),
      cumulative_variance_explained_pct = as.numeric(cumsum(100 * (pca$sdev^2 / sum(pca$sdev^2)))),
      stringsAsFactors = FALSE
    )
    utils::write.table(
      pca_var_df,
      file = file.path(qc_dir, "pca_variance_explained.tsv"),
      sep = "\t",
      quote = FALSE,
      row.names = FALSE
    )

    assoc_columns <- unique(c(
      de_columns_resolved,
      de_block_resolved,
      pca_color_by_use,
      pca_shape_by_values_use,
      auto_categorical_columns
    ))
    assoc_columns <- assoc_columns[assoc_columns %in% colnames(col_data)]
    assoc_columns <- assoc_columns[
      vapply(assoc_columns, function(x) is_informative_column(col_data, x), logical(1))
    ]
    n_pcs_assoc <- min(5, ncol(pca$x))
    pca_assoc_rows <- list()
    if (n_pcs_assoc >= 1 && length(assoc_columns) > 0) {
      for (pc_idx in seq_len(n_pcs_assoc)) {
        pc_name <- paste0("PC", pc_idx)
        pc_vals <- as.numeric(pca_df[[pc_name]])
        for (column_name in assoc_columns) {
          var_vals <- col_data[[column_name]]
          keep <- !is.na(pc_vals) & !is.na(var_vals)
          if (sum(keep) < 4) {
            next
          }
          df_model <- data.frame(
            pc_value = pc_vals[keep],
            variable = var_vals[keep],
            stringsAsFactors = FALSE
          )
          n_unique <- length(unique(df_model$variable))
          if (n_unique < 2) {
            next
          }
          is_numeric_predictor <- is.numeric(df_model$variable) || is.integer(df_model$variable)
          if (!is_numeric_predictor) {
            df_model$variable <- as.factor(as.character(df_model$variable))
          }
          fit <- tryCatch(
            stats::lm(pc_value ~ variable, data = df_model),
            error = function(e) NULL
          )
          if (is.null(fit)) {
            next
          }
          fit_anova <- tryCatch(stats::anova(fit), error = function(e) NULL)
          if (is.null(fit_anova) || nrow(fit_anova) < 1) {
            next
          }
          p_value <- suppressWarnings(as.numeric(fit_anova[1, "Pr(>F)"]))
          r2 <- suppressWarnings(as.numeric(summary(fit)$r.squared))
          pca_assoc_rows[[length(pca_assoc_rows) + 1]] <- data.frame(
            factor = column_name,
            pc = pc_name,
            p_value = p_value,
            r_squared = r2,
            n_samples = nrow(df_model),
            n_levels = if (is_numeric_predictor) NA_integer_ else n_unique,
            predictor_type = if (is_numeric_predictor) "numeric" else "categorical",
            stringsAsFactors = FALSE
          )
        }
      }
    }
    if (length(pca_assoc_rows) > 0) {
      pca_assoc_df <- do.call(rbind, pca_assoc_rows)
      pca_assoc_df$fdr_bh <- NA_real_
      for (pc_name in unique(pca_assoc_df$pc)) {
        idx <- which(pca_assoc_df$pc == pc_name & is.finite(pca_assoc_df$p_value))
        if (length(idx) > 0) {
          pca_assoc_df$fdr_bh[idx] <- stats::p.adjust(pca_assoc_df$p_value[idx], method = "BH")
        }
      }
      pca_assoc_df <- pca_assoc_df[order(pca_assoc_df$pc, pca_assoc_df$p_value), , drop = FALSE]
      utils::write.table(
        pca_assoc_df,
        file = file.path(qc_dir, "pca_factor_association.tsv"),
        sep = "\t",
        quote = FALSE,
        row.names = FALSE
      )
    }

    pca_pairs <- unique_pca_pairs(c(list(c(1, 2)), pca_extra_pairs), ncol(pca$x))
    pca_plot_rows <- list()

    plot_pca_pair <- function(pc_x, pc_y, color_col, shape_col = "") {
      xcol <- paste0("PC", pc_x)
      ycol <- paste0("PC", pc_y)
      if (!(xcol %in% colnames(pca_df)) || !(ycol %in% colnames(pca_df))) {
        return(NULL)
      }
      if (!(color_col %in% colnames(pca_df))) {
        return(NULL)
      }
      plot_df <- pca_df
      plot_df[[color_col]] <- as.factor(as.character(plot_df[[color_col]]))
      color_map <- categorical_palette(
        levels(plot_df[[color_col]]),
        palette_name = palette_name_for_column(color_col)
      )
      if (length(color_map) == 0) {
        return(NULL)
      }
      if (nzchar(shape_col) && shape_col %in% colnames(plot_df)) {
        plot_df[[shape_col]] <- as.factor(as.character(plot_df[[shape_col]]))
      }
      title_text <- paste0("PCA colored by ", humanize_label(color_col))
      subtitle_text <- if (nzchar(shape_col)) paste0("Shape: ", humanize_label(shape_col)) else NULL
      p <- ggplot2::ggplot(plot_df, ggplot2::aes_string(x = xcol, y = ycol, color = color_col))
      if (nzchar(shape_col) && shape_col %in% colnames(plot_df)) {
        p <- p + ggplot2::geom_point(ggplot2::aes_string(shape = shape_col), size = 3)
      } else {
        p <- p + ggplot2::geom_point(size = 3)
      }
      p <- p +
        ggplot2::scale_color_manual(values = color_map, drop = FALSE) +
        ggplot2::xlab(paste0(xcol, ": ", pct[pc_x], "% variance")) +
        ggplot2::ylab(paste0(ycol, ": ", pct[pc_y], "% variance")) +
        ggplot2::labs(color = humanize_label(color_col), shape = if (nzchar(shape_col)) humanize_label(shape_col) else NULL, title = title_text, subtitle = subtitle_text) +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), aspect.ratio = 1)
      shape_suffix <- if (nzchar(shape_col)) paste0("_shape_", sanitize_file_component(shape_col, "shape")) else ""
      out_name <- paste0(top_variable_feature_stem, ".PCA_plot_", sanitize_file_component(color_col, "color"), shape_suffix, "_PC", pc_x, "_PC", pc_y, ".pdf")
      ggplot2::ggsave(filename = file.path(qc_dir, out_name), plot = p, width = 8, height = 8)
      data.frame(
        file = out_name,
        color_by = color_col,
        shape_by = if (nzchar(shape_col)) shape_col else "",
        pc_x = pc_x,
        pc_y = pc_y,
        stringsAsFactors = FALSE
      )
    }

    if (length(pca_pairs) > 0) {
      for (color_col in pca_color_by_use) {
        for (pair in pca_pairs) {
          plot_row <- plot_pca_pair(pair[1], pair[2], color_col, "")
          if (!is.null(plot_row)) {
            pca_plot_rows[[length(pca_plot_rows) + 1]] <- plot_row
          }
        }
      }
      if (length(pca_color_by_use) > 0 && length(pca_shape_by_values_use) > 0) {
        primary_color_col <- pca_color_by_use[[1]]
        for (shape_col in pca_shape_by_values_use) {
          if (metadata_columns_redundant(col_data, primary_color_col, shape_col)) {
            next
          }
          for (pair in pca_pairs) {
            plot_row <- plot_pca_pair(pair[1], pair[2], primary_color_col, shape_col)
            if (!is.null(plot_row)) {
              pca_plot_rows[[length(pca_plot_rows) + 1]] <- plot_row
            }
          }
        }
      }
    }

    if (length(pca_plot_rows) > 0) {
      utils::write.table(
        do.call(rbind, pca_plot_rows),
        file = file.path(qc_dir, "pca_plot_manifest.tsv"),
        sep = "\t",
        quote = FALSE,
        row.names = FALSE
      )
    }
  }
}

