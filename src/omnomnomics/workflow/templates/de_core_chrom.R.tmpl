      )
      bar_plot <- tryCatch(
        clusterProfiler::barplot(ora_obj, showCategory = enrichment_top_terms) +
          ggplot2::ggtitle(paste0(contrast_label, " ", set_name, " ORA (", direction_label, ")")) +
          ggplot2::labs(subtitle = direction_caption),
        error = function(e) NULL
      )
      save_enrichment_plot(
        bar_plot,
        file.path(output_dir, paste0(contrast_label, ".", set_name, ".", direction_label, ".barplot.ORA.pdf"))
      )
      enrichment_rows[[length(enrichment_rows) + 1]] <<- data.frame(
        contrast = contrast_label,
        positive_direction = positive_direction,
        negative_direction = negative_direction,
        method = "ORA",
        gene_set = paste0(split_name, "::", set_name),
        direction = direction_label,
        terms = nrow(ora_tbl),
        top_term = as.character(ora_tbl$Description[[1]]),
        top_padj = as.numeric(ora_tbl$p.adjust[[1]]),
        stringsAsFactors = FALSE
      )
      ora_tbl
    }

    run_gsea_term2gene <- function(ranked_vec, term2gene_tbl, set_name, output_dir = cp_dir, split_name = "all") {
      if (length(ranked_vec) < 10 || is.null(term2gene_tbl) || nrow(term2gene_tbl) == 0) {
        return(NULL)
      }
      gsea_args <- list(
        geneList = ranked_vec,
        TERM2GENE = term2gene_tbl,
        pvalueCutoff = enrichment_pvalue_cutoff,
        minGSSize = enrichment_min_gs_size,
        maxGSSize = enrichment_max_gs_size,
        verbose = FALSE
      )
      if ("nPermSimple" %in% names(formals(clusterProfiler::GSEA))) {
        gsea_args$nPermSimple <- enrichment_gsea_permutations
      }
      gsea_obj <- tryCatch(
        do.call(clusterProfiler::GSEA, gsea_args),
        error = function(e) {
          message("GSEA failed for ", contrast_label, " [", set_name, "]: ", conditionMessage(e))
          NULL
        }
      )
      gsea_tbl <- safe_cp_result_table(gsea_obj)
      if (is.null(gsea_tbl)) {
        return(NULL)
      }
      utils::write.table(
        gsea_tbl,
        file = file.path(output_dir, paste0(contrast_label, ".", set_name, ".GSEA.tsv")),
        sep = "\t",
        quote = FALSE,
        row.names = FALSE
      )
      dot_plot <- tryCatch(
        enrichplot::dotplot(gsea_obj, showCategory = enrichment_top_terms) +
          ggplot2::ggtitle(paste0(contrast_label, " ", set_name, " GSEA")) +
          ggplot2::labs(subtitle = direction_caption),
        error = function(e) NULL
      )
      save_enrichment_plot(
        dot_plot,
        file.path(output_dir, paste0(contrast_label, ".", set_name, ".dotplot.GSEA.pdf"))
      )
      ridge_plot <- tryCatch(
        enrichplot::ridgeplot(gsea_obj, showCategory = enrichment_top_terms) +
          ggplot2::ggtitle(paste0(contrast_label, " ", set_name, " GSEA")) +
          ggplot2::labs(subtitle = direction_caption),
        error = function(e) NULL
      )
      save_enrichment_plot(
        ridge_plot,
        file.path(output_dir, paste0(contrast_label, ".", set_name, ".ridgeplot.GSEA.pdf"))
      )
      top_ids <- head(as.character(gsea_tbl$ID), min(10, nrow(gsea_tbl)))
      if (length(top_ids) > 0) {
        for (term_id in top_ids) {
          gp <- tryCatch(
            enrichplot::gseaplot2(
              gsea_obj,
              geneSetID = term_id,
              title = paste0(term_id, "\n", direction_caption)
            ),
            error = function(e) NULL
          )
          save_enrichment_plot(
            gp,
            file.path(
              output_dir,
              paste0(contrast_label, ".", set_name, ".nesplot.", sanitize_file_component(term_id, "term"), ".GSEA.pdf")
            ),
            width = 10,
            height = 6
          )
        }
      }
      enrichment_rows[[length(enrichment_rows) + 1]] <<- data.frame(
        contrast = contrast_label,
        positive_direction = positive_direction,
        negative_direction = negative_direction,
        method = "GSEA",
        gene_set = paste0(split_name, "::", set_name),
        direction = "ranked",
        terms = nrow(gsea_tbl),
        top_term = as.character(gsea_tbl$Description[[1]]),
        top_padj = as.numeric(gsea_tbl$p.adjust[[1]]),
        stringsAsFactors = FALSE
      )
      gsea_tbl
    }

    for (split_name in names(split_sets)) {
      split_df <- split_sets[[split_name]]
      if (is.null(split_df) || nrow(split_df) < 10) {
        next
      }
      split_symbols <- split_df$gene_symbol_clean
      split_symbols <- split_symbols[!is.na(split_symbols) & nzchar(split_symbols)]
      universe_symbols <- unique(split_symbols)
      if (length(universe_symbols) < 10) {
        next
      }
      split_dir <- file.path(cp_dir, split_name)
      dir.create(split_dir, recursive = TRUE, showWarnings = FALSE)

      sig_for_enrich <- subset(split_df, !is.na(padj) & padj < enrichment_pvalue_cutoff)
      pos_symbols <- unique(sig_for_enrich$gene_symbol_clean[sig_for_enrich$log2FoldChange > 0 & !is.na(sig_for_enrich$gene_symbol_clean)])
      neg_symbols <- unique(sig_for_enrich$gene_symbol_clean[sig_for_enrich$log2FoldChange < 0 & !is.na(sig_for_enrich$gene_symbol_clean)])

      ranked_stats <- split_df$log2FoldChange
      names(ranked_stats) <- split_df$gene_symbol_clean
      ranked_stats <- ranked_stats[!is.na(names(ranked_stats)) & is.finite(ranked_stats)]
      ranked_stats <- deduplicate_ranked_vector(ranked_stats)

      if (enrichment_cp_run_ora) {
        for (set_name in names(msig_term2gene)) {
          run_ora_term2gene(pos_symbols, msig_term2gene[[set_name]], set_name, "up", universe_symbols, output_dir = split_dir, split_name = split_name)
          run_ora_term2gene(neg_symbols, msig_term2gene[[set_name]], set_name, "down", universe_symbols, output_dir = split_dir, split_name = split_name)
        }
      }
      if (enrichment_cp_run_gsea) {
        for (set_name in names(msig_term2gene)) {
          run_gsea_term2gene(ranked_stats, msig_term2gene[[set_name]], set_name, output_dir = split_dir, split_name = split_name)
        }
      }
    }
  }

  if (enrichment_enabled && custom_modules_enabled && !is.null(custom_modules_term2gene)) {
    cm_dir <- file.path(contrast_dir, "custom_modules")
    dir.create(cm_dir, recursive = TRUE, showWarnings = FALSE)
    cm_set_name <- sanitize_file_component(custom_modules_name, "custom_modules")
    split_sets_cm <- list(
      promoter = subset(enrich_df, peak_region %in% c("promoter")),
      distal = subset(enrich_df, peak_region %in% c("intergenic")),
      gene_body = subset(enrich_df, peak_region %in% c("exon", "intron"))
    )
    for (split_name in names(split_sets_cm)) {
      split_df <- split_sets_cm[[split_name]]
      if (is.null(split_df) || nrow(split_df) < 10) {
        next
      }
      split_symbols <- split_df$gene_symbol_clean
      split_symbols <- split_symbols[!is.na(split_symbols) & nzchar(split_symbols)]
      universe_symbols <- unique(split_symbols)
      if (length(universe_symbols) < 10) {
        next
      }
      split_dir <- file.path(cm_dir, split_name)
      dir.create(split_dir, recursive = TRUE, showWarnings = FALSE)

      sig_for_enrich <- subset(split_df, !is.na(padj) & padj < enrichment_pvalue_cutoff)
      pos_symbols <- unique(sig_for_enrich$gene_symbol_clean[sig_for_enrich$log2FoldChange > 0 & !is.na(sig_for_enrich$gene_symbol_clean)])
      neg_symbols <- unique(sig_for_enrich$gene_symbol_clean[sig_for_enrich$log2FoldChange < 0 & !is.na(sig_for_enrich$gene_symbol_clean)])

      ranked_stats <- split_df$log2FoldChange
      names(ranked_stats) <- split_df$gene_symbol_clean
      ranked_stats <- ranked_stats[!is.na(names(ranked_stats)) & is.finite(ranked_stats)]
      ranked_stats <- deduplicate_ranked_vector(ranked_stats)

      if (custom_modules_run_ora) {
        run_ora_term2gene(
          pos_symbols,
          custom_modules_term2gene,
          cm_set_name,
          "up",
          universe_symbols = universe_symbols,
          output_dir = split_dir,
          split_name = split_name
        )
        run_ora_term2gene(
          neg_symbols,
          custom_modules_term2gene,
          cm_set_name,
          "down",
          universe_symbols = universe_symbols,
          output_dir = split_dir,
          split_name = split_name
        )
      }

      if (custom_modules_run_gsea) {
        run_gsea_term2gene(
          ranked_stats,
          custom_modules_term2gene,
          cm_set_name,
          output_dir = split_dir,
          split_name = split_name
        )
      }
    }
  }

  if (enrichment_enabled && decoupler_enabled && decoupler_available &&
      (decoupler_run_progeny || decoupler_run_tf_network)) {
    dc_dir <- file.path(contrast_dir, "decoupler")
    dir.create(dc_dir, recursive = TRUE, showWarnings = FALSE)

    contrast_vst <- SummarizedExperiment::assay(vst_obj)[, contrast_sample_ids, drop = FALSE]
    sample_symbol_ids <- enrich_df$gene_symbol_clean[match(rownames(contrast_vst), enrich_df$gene_id)]
    missing_sample_symbols <- is.na(sample_symbol_ids) | !nzchar(sample_symbol_ids)
    if (any(missing_sample_symbols)) {
      sample_symbol_ids[missing_sample_symbols] <- symbols_for_ids(
        rownames(contrast_vst)[missing_sample_symbols],
        fallback_to_ids = FALSE
      )
    }
    sample_symbol_ids[!is_valid_symbol(sample_symbol_ids)] <- NA_character_
    dc_sample_mat <- aggregate_symbol_matrix(contrast_vst, sample_symbol_ids)

    deg_symbol_ids <- enrich_df$gene_symbol_clean
    dc_deg_mat_raw <- matrix(
      enrich_df$log2FoldChange,
      ncol = 1,
      dimnames = list(deg_symbol_ids, contrast_label)
    )
    dc_deg_mat <- aggregate_symbol_matrix(dc_deg_mat_raw, rownames(dc_deg_mat_raw))

    dc_deg_stats <- enrich_df[, c("gene_symbol_clean", "log2FoldChange", "pvalue"), drop = FALSE]
    dc_deg_stats <- dc_deg_stats[!is.na(dc_deg_stats$gene_symbol_clean), , drop = FALSE]
    dc_deg_stats <- dc_deg_stats[order(abs(dc_deg_stats$log2FoldChange), decreasing = TRUE), , drop = FALSE]
    dc_deg_stats <- dc_deg_stats[!duplicated(dc_deg_stats$gene_symbol_clean), , drop = FALSE]
    rownames(dc_deg_stats) <- dc_deg_stats$gene_symbol_clean

    species_dc <- if (species_info$species_label %in% c("human", "mouse")) species_info$species_label else "human"

    safe_decouple_run <- function(fun_name, mat, net, mor_col) {
      if (!(fun_name %in% getNamespaceExports("decoupleR"))) {
        return(NULL)
      }
      fun <- get(fun_name, envir = asNamespace("decoupleR"))
      tryCatch(
        fun(
          mat = mat,
          net = net,
          .source = "source",
          .target = "target",
          .mor = mor_col,
          minsize = decoupler_minsize
        ),
        error = function(e) {
          message("decoupleR ", fun_name, " failed in ", contrast_label, ": ", conditionMessage(e))
          NULL
        }
      )
    }

    plot_decoupler_detail <- function(net_tbl, activity_tbl, mor_col, out_prefix, label_suffix) {
      if (is.null(activity_tbl) || nrow(activity_tbl) == 0) {
        return()
      }
      activity_tbl <- activity_tbl[is.finite(activity_tbl$score), , drop = FALSE]
      if (nrow(activity_tbl) == 0) {
        return()
      }
      activity_tbl <- activity_tbl[order(activity_tbl$score), , drop = FALSE]
      n_each <- min(decoupler_top_regulators_detail_each_side, floor(nrow(activity_tbl) / 2))
      if (n_each < 1) {
        return()
      }
      top_regs <- c(
        head(activity_tbl$source, n_each),
        tail(activity_tbl$source, n_each)
      )
      top_regs <- unique(as.character(top_regs))
      cols <- rev(RColorBrewer::brewer.pal(n = 11, name = "RdBu")[c(2, 10)])
      for (reg in top_regs) {
        reg_net <- net_tbl[net_tbl$source == reg, c("target", mor_col), drop = FALSE]
        colnames(reg_net) <- c("target", "mor_value")
        reg_net <- reg_net[!is.na(reg_net$target), , drop = FALSE]
        if (nrow(reg_net) == 0) {
          next
        }
        inter <- intersect(reg_net$target, rownames(dc_deg_stats))
        if (length(inter) < 3) {
          next
        }
        plot_df <- data.frame(
          target = inter,
          mor = reg_net$mor_value[match(inter, reg_net$target)],
          logfc = dc_deg_stats[inter, "log2FoldChange"],
          pvalue = dc_deg_stats[inter, "pvalue"],
          stringsAsFactors = FALSE
        )
        plot_df$color_class <- "neutral"
        plot_df$color_class[plot_df$mor > 0 & plot_df$logfc > 0] <- "concordant"
        plot_df$color_class[plot_df$mor < 0 & plot_df$logfc < 0] <- "concordant"
        plot_df$color_class[plot_df$mor > 0 & plot_df$logfc < 0] <- "discordant"
        plot_df$color_class[plot_df$mor < 0 & plot_df$logfc > 0] <- "discordant"
        p <- ggplot2::ggplot(
          plot_df,
          ggplot2::aes(x = mor, y = logfc, color = color_class)
        ) +
          ggplot2::geom_point(size = 2) +
          ggplot2::scale_color_manual(values = c("concordant" = cols[2], "discordant" = cols[1], "neutral" = "grey60")) +
          ggplot2::geom_vline(xintercept = 0, linetype = "dotted") +
          ggplot2::geom_hline(yintercept = 0, linetype = "dotted") +
          ggplot2::theme_light() +
          ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
          ggplot2::xlab("Network weight") +
          ggplot2::ylab("log2 fold change") +
          ggplot2::ggtitle(reg)
        if (requireNamespace("ggrepel", quietly = TRUE)) {
          p <- p + ggrepel::geom_text_repel(
            data = head(plot_df[order(abs(plot_df$logfc), decreasing = TRUE), , drop = FALSE], 20),
            ggplot2::aes(label = target),
            size = 3
          )
        }
        save_enrichment_plot(
          p,
          file.path(dc_dir, paste0(out_prefix, ".DE_", feature_file_stem, ".in.", sanitize_file_component(reg, "regulator"), ".", label_suffix, ".pdf")),
          width = 9,
          height = 7
        )
      }
    }

    if (decoupler_run_progeny && nrow(dc_sample_mat) >= 20 && nrow(dc_deg_mat) >= 20 &&
        "get_progeny" %in% getNamespaceExports("decoupleR")) {
      prog_net <- tryCatch(
        decoupleR::get_progeny(organism = species_dc, top = decoupler_progeny_top),
        error = function(e) {
          message("get_progeny failed in ", contrast_label, ": ", conditionMessage(e))
          NULL
        }
      )
      if (!is.null(prog_net) && nrow(prog_net) > 0) {
        prog_all <- safe_decouple_run("run_mlm", dc_sample_mat, prog_net, "weight")
        prog_deg <- safe_decouple_run("run_mlm", dc_deg_mat, prog_net, "weight")
        if (!is.null(prog_all)) {
          utils::write.table(
            prog_all,
            file = file.path(dc_dir, paste0(contrast_label, ".", all_feature_file_stem, ".progeny_pathways.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          prog_all_mat <- decoupler_to_matrix(as.data.frame(prog_all))
          plot_decoupler_heatmap(
            prog_all_mat,
            file.path(dc_dir, paste0(contrast_label, ".", all_feature_file_stem, ".progeny_pathways.pdf")),
            paste0(contrast_label, " progeny pathway activity\n", direction_caption),
            top_features = decoupler_top_features_heatmap
          )
        }
        if (!is.null(prog_deg)) {
          utils::write.table(
            prog_deg,
            file = file.path(dc_dir, paste0(contrast_label, ".", de_feature_file_stem, ".progeny_pathways.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          plot_decoupler_bar(
            as.data.frame(prog_deg),
            file.path(dc_dir, paste0(contrast_label, ".", de_feature_file_stem, ".progeny_pathways.pdf")),
            paste0(contrast_label, " progeny pathway activity (DE ", feature_label_plural, ")\n", direction_caption),
            top_n = decoupler_top_regulators_barplot
          )
          plot_decoupler_detail(
            net_tbl = prog_net,
            activity_tbl = as.data.frame(prog_deg),
            mor_col = "weight",
            out_prefix = contrast_label,
            label_suffix = "progeny_pathway"
          )
          prog_deg_tbl <- as.data.frame(prog_deg)
          if (all(c("source", "score") %in% colnames(prog_deg_tbl))) {
            top_prog <- prog_deg_tbl[order(-abs(prog_deg_tbl$score)), , drop = FALSE]
            enrichment_rows[[length(enrichment_rows) + 1]] <- data.frame(
              contrast = contrast_label,
              positive_direction = positive_direction,
              negative_direction = negative_direction,
              method = "decoupleR_MLM",
              gene_set = "progeny",
              direction = "ranked",
              terms = nrow(prog_deg_tbl),
              top_term = as.character(top_prog$source[[1]]),
              top_padj = NA_real_,
              stringsAsFactors = FALSE
            )
          }
        }
      }
    }

    if (decoupler_run_tf_network && nrow(dc_sample_mat) >= 20 && nrow(dc_deg_mat) >= 20 &&
        "get_collectri" %in% getNamespaceExports("decoupleR")) {
      tf_net <- tryCatch(
        decoupleR::get_collectri(organism = species_dc, split_complexes = decoupler_tf_split_complexes),
        error = function(e) {
          message("get_collectri failed in ", contrast_label, ": ", conditionMessage(e))
          NULL
        }
      )
      if (!is.null(tf_net) && nrow(tf_net) > 0) {
        tf_all <- safe_decouple_run("run_ulm", dc_sample_mat, tf_net, "mor")
        tf_deg <- safe_decouple_run("run_ulm", dc_deg_mat, tf_net, "mor")
        if (!is.null(tf_all)) {
          utils::write.table(
            tf_all,
            file = file.path(dc_dir, paste0(contrast_label, ".", all_feature_file_stem, ".TF_network_activity.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          tf_all_mat <- decoupler_to_matrix(as.data.frame(tf_all))
          plot_decoupler_heatmap(
            tf_all_mat,
            file.path(dc_dir, paste0(contrast_label, ".", all_feature_file_stem, ".TF_network_activity.pdf")),
            paste0(contrast_label, " TF network activity\n", direction_caption),
            top_features = decoupler_top_features_heatmap
          )
        }
        if (!is.null(tf_deg)) {
          utils::write.table(
            tf_deg,
            file = file.path(dc_dir, paste0(contrast_label, ".", de_feature_file_stem, ".TF_network_activity.tsv")),
            sep = "\t",
            quote = FALSE,
            row.names = FALSE
          )
          plot_decoupler_bar(
            as.data.frame(tf_deg),
            file.path(dc_dir, paste0(contrast_label, ".", de_feature_file_stem, ".TF_network_activity.pdf")),
            paste0(contrast_label, " TF network activity (DE ", feature_label_plural, ")\n", direction_caption),
            top_n = decoupler_top_regulators_barplot
          )
          plot_decoupler_detail(
            net_tbl = tf_net,
            activity_tbl = as.data.frame(tf_deg),
            mor_col = "mor",
            out_prefix = contrast_label,
            label_suffix = "TF_network_activity"
          )
          tf_deg_tbl <- as.data.frame(tf_deg)
          if (all(c("source", "score") %in% colnames(tf_deg_tbl))) {
            top_tf <- tf_deg_tbl[order(-abs(tf_deg_tbl$score)), , drop = FALSE]
            enrichment_rows[[length(enrichment_rows) + 1]] <- data.frame(
              contrast = contrast_label,
              positive_direction = positive_direction,
              negative_direction = negative_direction,
              method = "decoupleR_ULM",
              gene_set = "collectri_tf",
              direction = "ranked",
              terms = nrow(tf_deg_tbl),
              top_term = as.character(top_tf$source[[1]]),
              top_padj = NA_real_,
              stringsAsFactors = FALSE
            )
          }
        }
      }
    }
  }

  build_contrast_combined_summary <- function() {
    panel_volcano <- NULL
    panel_top_genes <- NULL
    panel_top_paths <- NULL
    panel_decoupler <- NULL

    vdf <- res_df
    vdf$padj[is.na(vdf$padj)] <- 1
    vdf$log2FoldChange[is.na(vdf$log2FoldChange)] <- 0
    vdf$neglog10padj <- -log10(pmax(vdf$padj, 1e-300))
    vdf$is_sig <- vdf$padj < alpha & abs(vdf$log2FoldChange) >= lfc_for_sig
    panel_volcano <- ggplot2::ggplot(vdf, ggplot2::aes(x = log2FoldChange, y = neglog10padj, color = is_sig)) +
      ggplot2::geom_point(alpha = 0.6, size = 1.0) +
      ggplot2::scale_color_manual(values = c("FALSE" = "grey70", "TRUE" = "firebrick")) +
      ggplot2::geom_vline(xintercept = c(-lfc_for_sig, 0, lfc_for_sig), linetype = c("dashed", "solid", "dashed")) +
      ggplot2::geom_hline(yintercept = -log10(alpha), linetype = "dashed") +
      ggplot2::theme_light() +
      ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
      ggplot2::xlab("log2 fold change") +
      ggplot2::ylab("-log10 adjusted p-value") +
      ggplot2::ggtitle(paste0(contrast_label, " volcano")) +
      ggplot2::labs(subtitle = direction_caption)

    tg <- sig_df
    if (nrow(tg) > 0) {
      tg <- tg[order(tg$padj, -abs(tg$log2FoldChange)), , drop = FALSE]
      tg <- head(tg, 12)
      tg$gene_plot <- tg$feature_label
      tg$direction <- ifelse(tg$log2FoldChange >= 0, "up", "down")
      tg$gene_plot <- factor(tg$gene_plot, levels = rev(tg$gene_plot))
      panel_top_genes <- ggplot2::ggplot(
        tg,
        ggplot2::aes(x = gene_plot, y = log2FoldChange, fill = direction)
      ) +
        ggplot2::geom_col() +
        ggplot2::coord_flip() +
        ggplot2::scale_fill_manual(values = c("up" = "firebrick", "down" = "steelblue")) +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
        ggplot2::xlab(NULL) +
        ggplot2::ylab("log2 fold change") +
        ggplot2::ggtitle(paste("Top DE", feature_label_plural))
    } else {
      panel_top_genes <- ggplot2::ggplot() +
        ggplot2::annotate("text", x = 0.5, y = 0.5, label = paste("No significant", feature_label_plural)) +
        ggplot2::theme_void() +
        ggplot2::ggtitle(paste("Top DE", feature_label_plural))
    }

    path_rows <- list()
    cp_dir <- file.path(contrast_dir, "clusterProfiler")
    if (dir.exists(cp_dir)) {
      cp_tables <- list.files(cp_dir, pattern = "\\.(ORA|GSEA)\\.tsv$", full.names = TRUE)
      for (tab in cp_tables) {
        tab_df <- tryCatch(utils::read.delim(tab, stringsAsFactors = FALSE, check.names = FALSE), error = function(e) NULL)
        if (is.null(tab_df) || nrow(tab_df) == 0) {
          next
        }
        p_col <- if ("p.adjust" %in% colnames(tab_df)) "p.adjust" else if ("qvalue" %in% colnames(tab_df)) "qvalue" else NA_character_
        d_col <- if ("Description" %in% colnames(tab_df)) "Description" else if ("ID" %in% colnames(tab_df)) "ID" else NA_character_
        if (is.na(p_col) || is.na(d_col)) {
          next
        }
        score <- -log10(pmax(as.numeric(tab_df[[p_col]]), 1e-300))
        keep <- is.finite(score)
        if (!any(keep)) {
          next
        }
        top_idx <- order(score[keep], decreasing = TRUE)
        top_labels <- as.character(tab_df[[d_col]][keep])[top_idx]
        top_scores <- score[keep][top_idx]
        n_take <- min(5, length(top_scores))
        if (n_take < 1) {
          next
        }
        path_rows[[length(path_rows) + 1]] <- data.frame(
          term = top_labels[seq_len(n_take)],
          score = top_scores[seq_len(n_take)],
          source = sub(paste0("^", contrast_label, "\\."), "", basename(tab)),
          stringsAsFactors = FALSE
        )
      }
    }
    if (length(path_rows) > 0) {
      path_df <- do.call(rbind, path_rows)
      path_df <- path_df[order(path_df$score, decreasing = TRUE), , drop = FALSE]
      path_df <- reduce_redundant_terms(
        path_df,
        term_col = "term",
        score_col = "score",
        max_terms = 12,
        jaccard_cutoff = 0.6
      )
      path_df$term <- factor(path_df$term, levels = rev(unique(path_df$term)))
      panel_top_paths <- ggplot2::ggplot(path_df, ggplot2::aes(x = term, y = score, fill = source)) +
        ggplot2::geom_col() +
        ggplot2::coord_flip() +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
        ggplot2::xlab(NULL) +
        ggplot2::ylab("-log10 adjusted p-value") +
        ggplot2::ggtitle("Top enriched pathways")
    } else {
      panel_top_paths <- ggplot2::ggplot() +
        ggplot2::annotate("text", x = 0.5, y = 0.5, label = "No enrichment results") +
        ggplot2::theme_void() +
        ggplot2::ggtitle("Top enriched pathways")
    }

    dc_rows <- list()
    dc_dir <- file.path(contrast_dir, "decoupler")
    if (dir.exists(dc_dir)) {
      dc_tables <- list.files(dc_dir, pattern = "\\.tsv$", full.names = TRUE)
      for (tab in dc_tables) {
        tab_df <- tryCatch(utils::read.delim(tab, stringsAsFactors = FALSE, check.names = FALSE), error = function(e) NULL)
        if (is.null(tab_df) || nrow(tab_df) == 0) {
          next
        }
        if (!all(c("source", "score") %in% colnames(tab_df))) {
          next
        }
        keep <- is.finite(as.numeric(tab_df$score))
        if (!any(keep)) {
          next
        }
        tmp <- tab_df[keep, c("source", "score"), drop = FALSE]
        tmp$score <- as.numeric(tmp$score)
        tmp <- tmp[order(abs(tmp$score), decreasing = TRUE), , drop = FALSE]
        tmp <- head(tmp, 5)
        tmp$source_file <- sub(paste0("^", contrast_label, "\\."), "", basename(tab))
        dc_rows[[length(dc_rows) + 1]] <- tmp
      }
    }
    if (length(dc_rows) > 0) {
      dc_df <- do.call(rbind, dc_rows)
      dc_df <- dc_df[order(abs(dc_df$score), decreasing = TRUE), , drop = FALSE]
      dc_df <- head(dc_df, 12)
      dc_df$regulator <- factor(dc_df$source, levels = rev(unique(dc_df$source)))
      panel_decoupler <- ggplot2::ggplot(dc_df, ggplot2::aes(x = regulator, y = score, fill = source_file)) +
        ggplot2::geom_col() +
        ggplot2::coord_flip() +
        ggplot2::theme_light() +
        ggplot2::theme(panel.grid = ggplot2::element_blank(), legend.position = "none") +
        ggplot2::xlab(NULL) +
        ggplot2::ylab("Activity score") +
        ggplot2::ggtitle("Top decoupleR activities")
    } else {
      panel_decoupler <- ggplot2::ggplot() +
        ggplot2::annotate("text", x = 0.5, y = 0.5, label = "No decoupleR results") +
        ggplot2::theme_void() +
        ggplot2::ggtitle("Top decoupleR activities")
    }

    out_file <- file.path(contrast_dir, paste0(contrast_label, ".combined_summary.pdf"))
    grDevices::pdf(out_file, width = 14, height = 10)
    grid::grid.newpage()
    lay <- grid::grid.layout(
      nrow = 2,
      ncol = 2,
      widths = grid::unit(c(1, 1), "null"),
      heights = grid::unit(c(1, 1), "null")
    )
    grid::pushViewport(grid::viewport(layout = lay))
    print(panel_volcano, vp = grid::viewport(layout.pos.row = 1, layout.pos.col = 1))
    print(panel_top_genes, vp = grid::viewport(layout.pos.row = 1, layout.pos.col = 2))
    print(panel_top_paths, vp = grid::viewport(layout.pos.row = 2, layout.pos.col = 1))
    print(panel_decoupler, vp = grid::viewport(layout.pos.row = 2, layout.pos.col = 2))
    grid::popViewport()
    grDevices::dev.off()
  }

  build_contrast_combined_summary()
}

