resolve_coefficient_shorthand <- function(raw_name, available_coefficients) {
  name <- trimws(as.character(raw_name))
  if (!nzchar(name)) {
    return(NULL)
  }
  if (name %in% available_coefficients) {
    return(name)
  }
  if (!grepl(":", name, fixed = TRUE)) {
    return(NULL)
  }
  term_tokens <- unlist(strsplit(name, ":", fixed = TRUE))
  term_tokens <- trimws(term_tokens)
  term_tokens <- term_tokens[nzchar(term_tokens)]
  if (length(term_tokens) < 2) {
    return(NULL)
  }
  idx <- rep(TRUE, length(available_coefficients))
  for (tok in term_tokens) {
    idx <- idx & grepl(tok, available_coefficients, fixed = TRUE)
  }
  candidates <- available_coefficients[idx]
  if (length(candidates) == 1) {
    return(candidates[[1]])
  }
  if (length(candidates) > 1) {
    forward_pattern <- paste(term_tokens, collapse = ".*")
    reverse_pattern <- paste(rev(term_tokens), collapse = ".*")
    forward <- candidates[grepl(forward_pattern, candidates)]
    reverse <- candidates[grepl(reverse_pattern, candidates)]
    narrowed <- unique(c(forward, reverse))
    if (length(narrowed) == 1) {
      return(narrowed[[1]])
    }
  }
  NULL
}

validate_contrast_plan <- function(plan, available_coefficients, metadata_df) {
  available_coefficients <- unique(as.character(available_coefficients))
  available_coefficients <- available_coefficients[!is.na(available_coefficients) & nzchar(available_coefficients)]
  valid_plan <- list()
  for (i in seq_along(plan)) {
    item <- plan[[i]]
    ctype <- as.character(item$contrast_type)
    if (identical(ctype, "factor")) {
      factor_name <- as.character(item$factor)
      numerator <- as.character(item$numerator)
      denominator <- as.character(item$denominator)
      if (!(factor_name %in% colnames(metadata_df))) {
        record_skipped_contrast(item$label, ctype, paste0("Metadata column '", factor_name, "' is not present."))
        next
      }
      level_values <- unique(as.character(metadata_df[[factor_name]]))
      level_values <- level_values[!is.na(level_values) & nzchar(level_values)]
      if (!(numerator %in% level_values)) {
        record_skipped_contrast(item$label, ctype, paste0("Numerator '", numerator, "' is not present after count-table matching/filtering."))
        next
      }
      if (!(denominator %in% level_values)) {
        record_skipped_contrast(item$label, ctype, paste0("Denominator '", denominator, "' is not present after count-table matching/filtering."))
        next
      }
      valid_plan[[length(valid_plan) + 1]] <- item
      next
    }
    if (identical(ctype, "coefficient")) {
      coef_name <- as.character(item$coefficient_name)
      if (!nzchar(coef_name)) {
        record_skipped_contrast(item$label, ctype, "Empty coefficient_name.")
        next
      }
      resolved_coef <- resolve_coefficient_shorthand(coef_name, available_coefficients)
      if (!is.null(resolved_coef) && nzchar(resolved_coef)) {
        if (!identical(resolved_coef, coef_name)) {
          message(
            "Resolved coefficient shorthand for contrast ", i, ": '", coef_name,
            "' -> '", resolved_coef, "'."
          )
        }
        plan[[i]]$coefficient_name <- resolved_coef
        coef_name <- resolved_coef
      }
      if (!(coef_name %in% available_coefficients)) {
        tokens <- unique(unlist(strsplit(gsub("[^A-Za-z0-9]+", " ", coef_name), "\\s+")))
        tokens <- tokens[nzchar(tokens)]
        candidate_idx <- rep(TRUE, length(available_coefficients))
        if (length(tokens) > 0) {
          for (tok in tokens) {
            candidate_idx <- candidate_idx & grepl(tok, available_coefficients, fixed = TRUE)
          }
        }
        candidates <- available_coefficients[candidate_idx]
        if (length(candidates) == 0) {
          candidates <- available_coefficients
        }
        candidates <- head(candidates, 10)
        record_skipped_contrast(
          item$label,
          ctype,
          paste0(
            "Requested coefficient_name '", coef_name,
            "' is not present in resultsNames(dds). Available examples: ",
            paste(candidates, collapse = ", ")
          )
        )
        next
      }
      valid_plan[[length(valid_plan) + 1]] <- item
      next
    }
    stop("Contrast ", i, " has unsupported contrast_type '", ctype, "'.")
  }
  valid_plan
}

