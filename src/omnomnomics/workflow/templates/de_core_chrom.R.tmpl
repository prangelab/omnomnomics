    "gene_symbol"
  )
  table_front_cols <- table_front_cols[table_front_cols %in% colnames(res_df)]
  res_df <- res_df[, c(table_front_cols, setdiff(colnames(res_df), table_front_cols)), drop = FALSE]
  sig_df <- subset(res_df, !is.na(padj) & padj < alpha & abs(log2FoldChange) >= lfc_for_sig)

