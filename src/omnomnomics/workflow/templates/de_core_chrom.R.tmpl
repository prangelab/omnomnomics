sanitize_name <- function(x) {
  x <- gsub("[^A-Za-z0-9._-]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^[_\\.\\-]+|[_\\.\\-]+$", "", x)
  if (!nzchar(x)) "contrast" else x
}

sanitize_file_component <- function(x, fallback = "item") {
  x <- gsub("[^A-Za-z0-9._-]+", "_", x)
  x <- gsub("_+", "_", x)
  x <- gsub("^[_\\.\\-]+|[_\\.\\-]+$", "", x)
  if (!nzchar(x)) fallback else x
}

humanize_label <- function(x) {
  x <- gsub("[_.-]+", " ", as.character(x))
  x <- gsub("\\s+", " ", x)
  x <- trimws(x)
  if (!nzchar(x)) "metadata" else x
}

is_informative_column <- function(df, column_name) {
  if (!(column_name %in% colnames(df))) {
    return(FALSE)
  }
  values <- as.character(df[[column_name]])
  values <- values[!is.na(values) & nzchar(values)]
  n_unique <- length(unique(values))
  n_unique >= 2 && n_unique < nrow(df)
}

is_categorical_grouping_column <- function(df, column_name) {
  if (!(column_name %in% colnames(df))) {
    return(FALSE)
  }
  values_raw <- df[[column_name]]
  if (is.numeric(values_raw) || is.integer(values_raw)) {
    return(FALSE)
  }
  is_informative_column(df, column_name)
}

metadata_column_signature <- function(df, column_name) {
  values <- as.character(df[[column_name]])
  values[is.na(values) | !nzchar(values)] <- "<NA>"
  paste(values, collapse = "\r")
}

metadata_columns_redundant <- function(df, column_a, column_b) {
  if (!(column_a %in% colnames(df)) || !(column_b %in% colnames(df))) {
    return(FALSE)
  }
  identical(metadata_column_signature(df, column_a), metadata_column_signature(df, column_b))
}

select_nonredundant_metadata_columns <- function(candidates, df, max_columns = 3, existing_columns = character(0)) {
  selected <- character(0)
  signatures <- character(0)
  for (column_name in unique(existing_columns)) {
    if (column_name %in% colnames(df)) {
      signatures <- c(signatures, metadata_column_signature(df, column_name))
    }
  }
  for (column_name in unique(candidates)) {
    if (!(column_name %in% colnames(df)) || !is_informative_column(df, column_name)) {
      next
    }
    signature <- metadata_column_signature(df, column_name)
    if (signature %in% signatures) {
      next
    }
    selected <- c(selected, column_name)
    signatures <- c(signatures, signature)
    if (length(selected) >= max_columns) {
      break
    }
  }
  selected
}

unique_pca_pairs <- function(pair_list, max_pc) {
  selected <- list()
  seen <- character(0)
  for (pair in pair_list) {
    pair <- as.integer(pair)
    if (length(pair) < 2 || any(is.na(pair[1:2])) || any(pair[1:2] < 1) || any(pair[1:2] > max_pc) || pair[1] == pair[2]) {
      next
    }
    key <- paste(pair[1], pair[2], sep = "_")
    if (key %in% seen) {
      next
    }
    seen <- c(seen, key)
    selected[[length(selected) + 1]] <- pair[1:2]
  }
  selected
}

qualitative_palette_names <- c("Set1", "Dark2", "Paired", "Set2", "Accent", "Pastel1", "Pastel2", "Set3")
palette_cache <- new.env(parent = emptyenv())
palette_assignment_rows <- list()

palette_name_for_column <- function(column_name) {
  column_name <- as.character(column_name)
  if (!nzchar(column_name)) {
    return(qualitative_palette_names[[1]])
  }
  if (exists(column_name, envir = palette_cache, inherits = FALSE)) {
    return(get(column_name, envir = palette_cache, inherits = FALSE))
  }
  used <- unlist(as.list(palette_cache), use.names = FALSE)
  available <- setdiff(qualitative_palette_names, used)
  if (length(available) == 0) {
    available <- qualitative_palette_names
  }
  idx <- (sum(utf8ToInt(column_name)) %% length(available)) + 1
  selected <- available[[idx]]
  assign(column_name, selected, envir = palette_cache)
  palette_assignment_rows[[length(palette_assignment_rows) + 1]] <<- data.frame(
    column = column_name,
    palette = selected,
    stringsAsFactors = FALSE
  )
  selected
}

categorical_palette <- function(levels_vec, palette_name = NULL) {
  levels_vec <- unique(as.character(levels_vec))
  levels_vec <- levels_vec[nzchar(levels_vec)]
  if (length(levels_vec) == 0) {
    return(c())
  }
  brewer_info <- RColorBrewer::brewer.pal.info
  if (is.null(palette_name) || !(palette_name %in% rownames(brewer_info))) {
    qualitative <- rownames(brewer_info[brewer_info$category == "qual", , drop = FALSE])
    palette_name <- qualitative[which.max(brewer_info[qualitative, "maxcolors"])]
  }
  base_n <- brewer_info[palette_name, "maxcolors"]
  base_palette <- RColorBrewer::brewer.pal(max(3, min(base_n, length(levels_vec))), palette_name)
  if (length(levels_vec) > length(base_palette)) {
    base_palette <- grDevices::colorRampPalette(base_palette)(length(levels_vec))
  } else {
    base_palette <- base_palette[seq_len(length(levels_vec))]
  }
  stats::setNames(base_palette, levels_vec)
}

prepare_pheatmap_annotations <- function(annotation_df, annotation_colors = NULL) {
  if (is.null(annotation_df) || !nrow(annotation_df) || !ncol(annotation_df)) {
    return(list(annotation_df = NULL, annotation_colors = NULL))
  }

  cleaned_df <- as.data.frame(annotation_df, stringsAsFactors = FALSE)
  cleaned_colors <- list()
  keep_columns <- character(0)

  for (column_name in colnames(cleaned_df)) {
    values <- as.character(cleaned_df[[column_name]])
    values[is.na(values) | !nzchar(values)] <- NA_character_
    levels_vec <- unique(values[!is.na(values)])
    if (length(levels_vec) < 1) {
      next
    }
    cleaned_df[[column_name]] <- factor(values, levels = levels_vec)

    column_colors <- NULL
    if (!is.null(annotation_colors) && column_name %in% names(annotation_colors)) {
      column_colors <- annotation_colors[[column_name]]
      column_colors <- column_colors[names(column_colors) %in% levels_vec]
    }
    if (is.null(column_colors) || !all(levels_vec %in% names(column_colors))) {
      column_colors <- categorical_palette(
        levels_vec,
        palette_name = palette_name_for_column(column_name)
      )
    } else {
      column_colors <- column_colors[levels_vec]
    }

    keep_columns <- c(keep_columns, column_name)
    cleaned_colors[[column_name]] <- column_colors
  }

  if (!length(keep_columns)) {
    return(list(annotation_df = NULL, annotation_colors = NULL))
  }

  list(
    annotation_df = cleaned_df[, keep_columns, drop = FALSE],
    annotation_colors = cleaned_colors
  )
}

gradient_palette <- function(n) {
  n <- max(3, as.integer(n))
  base_steps <- max(9, min(11, n))
  base_palette <- RColorBrewer::brewer.pal(base_steps, "RdBu")
  base_palette <- rev(base_palette)
  if (n > length(base_palette)) {
    return(grDevices::colorRampPalette(base_palette)(n))
  }
  stats::setNames(base_palette[seq_len(n)], NULL)
}

row_zscore <- function(mat) {
  scaled <- t(scale(t(mat)))
  scaled[is.na(scaled)] <- 0
  scaled
}

strip_ensembl_version <- function(ids) {
  sub("\\..*$", "", as.character(ids))
}

map_gene_symbols <- function(gene_ids, fallback_to_ids = TRUE) {
  gene_ids <- as.character(gene_ids)
  ids_no_version <- strip_ensembl_version(gene_ids)
  symbols <- rep(NA_character_, length(ids_no_version))

  has_annotationdbi <- requireNamespace("AnnotationDbi", quietly = TRUE)
  if (has_annotationdbi) {
    is_human <- grepl("^ENSG", ids_no_version)
    is_mouse <- grepl("^ENSMUSG", ids_no_version)

    if (any(is_human) && requireNamespace("org.Hs.eg.db", quietly = TRUE)) {
      mapped <- tryCatch(
        AnnotationDbi::mapIds(
          org.Hs.eg.db::org.Hs.eg.db,
          keys = unique(ids_no_version[is_human]),
          column = "SYMBOL",
          keytype = "ENSEMBL",
          multiVals = "first"
        ),
        error = function(e) {
          message("Symbol mapping warning (human): ", conditionMessage(e))
          stats::setNames(rep(NA_character_, length(unique(ids_no_version[is_human]))), unique(ids_no_version[is_human]))
        }
      )
      symbols[is_human] <- unname(mapped[ids_no_version[is_human]])
    }

    if (any(is_mouse) && requireNamespace("org.Mm.eg.db", quietly = TRUE)) {
      mapped <- tryCatch(
        AnnotationDbi::mapIds(
          org.Mm.eg.db::org.Mm.eg.db,
          keys = unique(ids_no_version[is_mouse]),
          column = "SYMBOL",
          keytype = "ENSEMBL",
          multiVals = "first"
        ),
        error = function(e) {
          message("Symbol mapping warning (mouse): ", conditionMessage(e))
          stats::setNames(rep(NA_character_, length(unique(ids_no_version[is_mouse]))), unique(ids_no_version[is_mouse]))
        }
      )
      symbols[is_mouse] <- unname(mapped[ids_no_version[is_mouse]])
    }
  }

  missing <- is.na(symbols) | !nzchar(symbols)
  if (fallback_to_ids) {
    symbols[missing] <- ids_no_version[missing]
  } else {
    symbols[missing] <- NA_character_
  }
  symbols
}

counts_df <- utils::read.delim(counts_path, check.names = FALSE, stringsAsFactors = FALSE)
metadata_df <- utils::read.delim(metadata_path, check.names = FALSE, stringsAsFactors = FALSE)

if (ncol(counts_df) < 2) {
  stop("Count table must contain a feature-id column and at least one sample column.")
}

if (!("sample_id" %in% colnames(metadata_df))) {
  stop("Derived metadata must contain sample_id.")
}

sample_columns <- colnames(counts_df)[-1]
if (all(sample_columns %in% metadata_df$sample_id)) {
  match_key <- "sample_id"
} else if ("filename_key" %in% colnames(metadata_df) && all(sample_columns %in% metadata_df$filename_key)) {
  match_key <- "filename_key"
} else {
  stop("Could not match count table sample columns to metadata sample_id or filename_key.")
}

metadata_df <- metadata_df[match(sample_columns, metadata_df[[match_key]]), , drop = FALSE]
if (any(is.na(metadata_df[[match_key]]))) {
  stop("Metadata matching produced missing rows.")
}

count_matrix <- as.matrix(counts_df[, sample_columns, drop = FALSE])
rownames(count_matrix) <- counts_df[[1]]
mode(count_matrix) <- "numeric"
raw_count_matrix <- count_matrix
non_integer <- abs(count_matrix - round(count_matrix)) > 1e-8
if (any(non_integer, na.rm = TRUE)) {
  stop("Count table contains non-integer values. DESeq2 requires raw integer counts.")
}
storage.mode(count_matrix) <- "integer"
genes_before_filter <- nrow(count_matrix)

col_data <- metadata_df
rownames(col_data) <- sample_columns

peak_data <- NULL
if (!is.na(peak_metadata_path) && file.exists(peak_metadata_path)) {
  peak_df <- utils::read.delim(peak_metadata_path, check.names = FALSE, stringsAsFactors = FALSE)
  if (!(peak_id_column %in% colnames(peak_df))) {
    stop(
      feature_metadata_label_title,
      " file is missing required key column '",
      peak_id_column,
      "': ",
      peak_metadata_path
    )
  }
  peak_key <- as.character(peak_df[[peak_id_column]])
  row_ids <- rownames(count_matrix)
  if (!all(row_ids %in% peak_key)) {
    missing_peak_rows <- setdiff(row_ids, peak_key)
    stop(
      feature_metadata_label_title,
      " is missing rows for count-table feature IDs. Missing example(s): ",
      paste(utils::head(missing_peak_rows, 10), collapse = ", ")
    )
  }
  peak_df <- peak_df[match(row_ids, peak_key), , drop = FALSE]
  rownames(peak_df) <- row_ids
  peak_data <- peak_df
  utils::write.table(
    peak_data,
    file = file.path(qc_dir, "peak_metadata_matched.tsv"),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )
  message("Loaded and matched ", feature_metadata_label, ": ", peak_metadata_path)
} else {
  message("No ", feature_metadata_label, " file provided; proceeding without peakData table.")
}

if (filtering_enabled && filtering_method == "min_count_samples") {
  keep <- rep(TRUE, nrow(count_matrix))

  min_samples_use <- filtering_min_samples
  if (identical(tolower(atac_filter_min_samples_mode), "per_group")) {
    if ("de_group" %in% colnames(col_data)) {
      group_sizes <- table(as.character(col_data$de_group))
      min_samples_use <- min(min_samples_use, as.integer(min(group_sizes)))
      min_samples_use <- max(1L, as.integer(min_samples_use))
    } else {
      warning("min_samples_mode='per_group' requested but de_group is missing; falling back to fixed min_samples.")
    }
  }
  keep <- keep & (rowSums(count_matrix >= filtering_min_count) >= min_samples_use)
  keep <- keep & (rowSums(count_matrix) >= atac_filter_min_total_count)

  count_matrix <- count_matrix[keep, , drop = FALSE]
  if (!is.null(peak_data)) {
    peak_data <- peak_data[rownames(count_matrix), , drop = FALSE]
  }
}
genes_after_filter <- nrow(count_matrix)

design_formula_base <- stats::as.formula(design_formula_text)
design_term_is_informative <- function(term_label, metadata_table) {
  term_vars <- all.vars(stats::as.formula(paste("~", term_label)))
  if (length(term_vars) == 0) {
    return(TRUE)
  }
  for (term_var in term_vars) {
    if (!(term_var %in% colnames(metadata_table))) {
      return(FALSE)
    }
    values <- metadata_table[[term_var]]
    if (is.numeric(values) || is.integer(values)) {
      values <- values[is.finite(values)]
      if (length(unique(values)) < 2) {
        return(FALSE)
      }
    } else {
      values <- as.character(values)
      values <- values[!is.na(values) & nzchar(values)]
      if (length(unique(values)) < 2) {
        return(FALSE)
      }
    }
  }
  TRUE
}

design_terms_requested <- attr(stats::terms(design_formula_base), "term.labels")
design_term_status <- data.frame(
  term = design_terms_requested,
  retained = logical(length(design_terms_requested)),
  reason = character(length(design_terms_requested)),
  stringsAsFactors = FALSE
)
if (length(design_terms_requested) > 0) {
  retained_terms <- vapply(design_terms_requested, design_term_is_informative, logical(1), metadata_table = col_data)
  design_term_status$retained <- retained_terms
  design_term_status$reason <- ifelse(retained_terms, "informative", "not variable after count-table matching/filtering")
  informative_terms <- design_terms_requested[retained_terms]
  if (length(informative_terms) == 0) {
    design_formula_base <- stats::as.formula("~ 1")
  } else if (length(informative_terms) < length(design_terms_requested)) {
    design_formula_base <- stats::reformulate(informative_terms)
  }
}
utils::write.table(
  design_term_status,
  file = file.path(qc_dir, "design_term_status.tsv"),
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)
design_formula <- design_formula_base
design_formula_effective_text <- paste(deparse(design_formula_base), collapse = " ")
latent_sv_columns <- character(0)
latent_message <- "Latent-factor correction disabled."
design_terms_effective <- attr(stats::terms(design_formula_base), "term.labels")
if (isTRUE(latent_enabled) && length(design_terms_effective) == 0) {
  latent_message <- "Latent-factor correction disabled because the effective design is intercept-only."
} else if (isTRUE(latent_enabled)) {
  latent_method <- tolower(trimws(as.character(latent_method)))
  if (!nzchar(latent_method) || latent_method != "sva") {
    stop("Unsupported latent factor method: ", latent_method, ". Currently supported: sva.")
  }
  if (!requireNamespace("sva", quietly = TRUE)) {
    stop("Latent factors requested but missing required R package: sva")
  }
  full_mod <- stats::model.matrix(design_formula_base, data = col_data)
  null_mod <- stats::model.matrix(~ 1, data = col_data)
  n_sv_use <- if (is.na(latent_n_sv)) NULL else as.integer(latent_n_sv)
  sv_obj <- tryCatch(
    sva::svaseq(counts = as.matrix(count_matrix), mod = full_mod, mod0 = null_mod, n.sv = n_sv_use),
    error = function(e) {
      stop("Failed to estimate latent factors with sva::svaseq: ", conditionMessage(e))
    }
  )
  sv_matrix <- sv_obj$sv
  if (is.null(sv_matrix) || ncol(sv_matrix) == 0) {
    latent_message <- "Latent-factor correction enabled, but sva returned zero surrogate variables."
  } else {
    sv_df <- as.data.frame(sv_matrix, stringsAsFactors = FALSE)
    latent_sv_columns <- paste0("sv", seq_len(ncol(sv_df)))
    colnames(sv_df) <- latent_sv_columns
    for (sv_col in latent_sv_columns) {
      col_data[[sv_col]] <- as.numeric(sv_df[[sv_col]])
    }
    design_formula_effective_text <- paste(design_formula_text, paste(latent_sv_columns, collapse = " + "), sep = " + ")
    design_formula <- stats::as.formula(design_formula_effective_text)
    latent_message <- paste0("Latent-factor correction enabled with ", length(latent_sv_columns), " surrogate variables.")
    latent_factors_tbl <- data.frame(
      sample_id = rownames(col_data),
