aggregate_symbol_matrix <- function(mat, symbols) {
  keep <- !is.na(symbols) & nzchar(symbols)
  mat <- mat[keep, , drop = FALSE]
  symbols <- symbols[keep]
  keep2 <- !duplicated(cbind(symbols, rownames(mat)))
  mat <- mat[keep2, , drop = FALSE]
  symbols <- symbols[keep2]
  if (nrow(mat) == 0) {
    return(mat)
  }
  summed <- rowsum(mat, group = symbols, reorder = FALSE)
  symbol_counts <- table(symbols)
  denom <- as.numeric(symbol_counts[rownames(summed)])
  denom[!is.finite(denom) | denom <= 0] <- 1
  swept <- sweep(summed, 1, denom, "/")
  swept
}

