contrast_summaries <- list()
contrast_testing_summaries <- list()
for (contrast_cfg in contrast_plan) {
  contrast_type <- as.character(contrast_cfg$contrast_type)
  factor_name <- as.character(contrast_cfg$factor)
  numerator <- as.character(contrast_cfg$numerator)
  denominator <- as.character(contrast_cfg$denominator)
  coefficient_name <- as.character(contrast_cfg$coefficient_name)
  contrast_label <- sanitize_name(as.character(contrast_cfg$label))
  contrast_dir <- file.path(de_dir, contrast_label)
  dir.create(contrast_dir, recursive = TRUE, showWarnings = FALSE)
  positive_direction <- "modeled numerator direction"
  negative_direction <- "opposite direction"
  if (contrast_type == "factor" && nzchar(factor_name) && nzchar(numerator) && nzchar(denominator)) {
    positive_direction <- paste0("higher in ", numerator, " vs ", denominator)
    negative_direction <- paste0("higher in ", denominator, " vs ", numerator)
  } else if (contrast_type == "coefficient" && nzchar(coefficient_name)) {
    positive_direction <- paste0("positive coefficient direction: ", coefficient_name)
    negative_direction <- "opposite coefficient direction"
  }
  direction_caption <- paste0("+: ", positive_direction, " | -: ", negative_direction)
  utils::write.table(
    data.frame(
      contrast = contrast_label,
      contrast_type = contrast_type,
      positive_direction = positive_direction,
      negative_direction = negative_direction,
      stringsAsFactors = FALSE
    ),
    file = file.path(contrast_dir, paste0(contrast_label, ".direction_legend.tsv")),
    sep = "\t",
    quote = FALSE,
    row.names = FALSE
  )

  contrast_sample_ids <- rownames(col_data)
  if (contrast_type == "factor" && factor_name %in% colnames(col_data)) {
    contrast_factor_values <- as.character(col_data[[factor_name]])
    keep_contrast_samples <- !is.na(contrast_factor_values) & contrast_factor_values %in% c(numerator, denominator)
    contrast_sample_ids <- rownames(col_data)[keep_contrast_samples]
    if (length(contrast_sample_ids) < 2) {
      message(
        "Contrast sample subsetting yielded <2 samples for ", contrast_label,
        ". Falling back to all samples for plotting."
      )
      contrast_sample_ids <- rownames(col_data)
    }
  }
  contrast_annotation_df <- NULL
  contrast_annotation_colors <- NULL
  if (!is.null(annotation_df_informative) && nrow(annotation_df_informative) > 0) {
    ann_keep <- intersect(contrast_sample_ids, rownames(annotation_df_informative))
    if (length(ann_keep) > 0) {
      contrast_annotation_df <- annotation_df_informative[ann_keep, , drop = FALSE]
      contrast_annotation <- prepare_pheatmap_annotations(contrast_annotation_df, annotation_colors_informative)
      contrast_annotation_df <- contrast_annotation$annotation_df
      contrast_annotation_colors <- contrast_annotation$annotation_colors
    }
  }

  if (contrast_type == "factor") {
    base_res <- DESeq2::results(dds, contrast = c(factor_name, numerator, denominator), alpha = alpha)
  } else {
    base_res <- DESeq2::results(dds, name = coefficient_name, alpha = alpha)
  }
  res_for_table <- base_res

  if (shrink_enabled) {
    shrunk <- tryCatch(
      if (contrast_type == "factor") {
        DESeq2::lfcShrink(dds, contrast = c(factor_name, numerator, denominator), type = shrink_type)
      } else {
        DESeq2::lfcShrink(dds, coef = coefficient_name, type = shrink_type)
      },
      error = function(e) {
        message("lfcShrink failed for ", contrast_label, ": ", conditionMessage(e), ". Falling back to unshrunk results.")
        base_res
      }
    )
    if (shrink_for_tables) {
      res_for_table <- shrunk
    }
  }

  res_df <- as.data.frame(res_for_table)
  res_df$gene_id <- rownames(res_df)
  res_df$gene_symbol <- symbols_for_ids(res_df$gene_id, fallback_to_ids = TRUE)
  res_df <- res_df[, c("gene_id", "gene_symbol", setdiff(colnames(res_df), c("gene_id", "gene_symbol")))]
  res_df <- res_df[order(res_df$padj, na.last = TRUE), , drop = FALSE]

  res_meta <- tryCatch(S4Vectors::metadata(res_for_table), error = function(e) list())
  independent_filtering_enabled <- if (!is.null(res_meta$independentFiltering)) {
    as.logical(res_meta$independentFiltering)
  } else {
    NA
  }
