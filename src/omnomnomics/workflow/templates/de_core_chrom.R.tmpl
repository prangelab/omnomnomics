    genes_with_padj = sum(!is.na(res_df$padj)),
    genes_pvalue_na = sum(is.na(res_df$pvalue)),
    genes_padj_na = sum(is.na(res_df$padj)),
    genes_padj_na_with_pvalue = sum(is.na(res_df$padj) & !is.na(res_df$pvalue)),
