    rank_slp_df <- res_df
    rank_slp_df$signed_log10_pvalue <- signed_log10p
    rank_slp <- build_rank_table(rank_slp_df, "signed_log10_pvalue")
    if (!is.null(rank_slp) && nrow(rank_slp) > 1) {
