  ranked_exports <- list()
  rank_lfc <- build_rank_table(res_df, "log2FoldChange")
  if (!is.null(rank_lfc) && nrow(rank_lfc) > 1) {
    out_rnk <- file.path(contrast_dir, paste0(contrast_label, ".ranked.log2FoldChange.rnk"))
    utils::write.table(rank_lfc, file = out_rnk, sep = "\t", quote = FALSE, row.names = FALSE, col.names = FALSE)
    ranked_exports[[length(ranked_exports) + 1]] <- data.frame(
