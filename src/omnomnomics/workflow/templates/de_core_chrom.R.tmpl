build_auto_contrasts <- function() {
  candidate <- auto_primary_variable
  if (!nzchar(candidate)) {
    terms_vec <- attr(stats::terms(design_formula_base), "term.labels")
    terms_vec <- terms_vec[!grepl(":", terms_vec, fixed = TRUE)]
    if (length(terms_vec) == 0) {
      record_skipped_contrast("auto", "factor", "Could not infer an auto contrast variable from the effective design formula.")
      return(list())
    }
    candidate <- terms_vec[length(terms_vec)]
  }
  if (!(candidate %in% colnames(col_data))) {
    record_skipped_contrast("auto", "factor", paste0("Auto contrast variable '", candidate, "' is not present in metadata."))
    return(list())
  }
  values <- as.factor(col_data[[candidate]])
  levels_vec <- levels(values)
  if (length(levels_vec) < 2) {
    record_skipped_contrast("auto", "factor", paste0("Auto contrast variable '", candidate, "' has fewer than two levels after count-table matching/filtering."))
    return(list())
  }
  contrast_list <- list()
  if (auto_pairwise) {
    for (i in seq_len(length(levels_vec) - 1)) {
      for (j in seq((i + 1), length(levels_vec))) {
        contrast_list[[length(contrast_list) + 1]] <- list(
          contrast_type = "factor",
          factor = candidate,
          numerator = levels_vec[i],
          denominator = levels_vec[j],
          coefficient_name = NA_character_,
          label = paste(levels_vec[i], "vs", levels_vec[j], sep = "_")
        )
      }
    }
  }
  contrast_list
}

normalize_contrast_item <- function(item, index = NA_integer_) {
  if (!is.list(item)) {
    stop("Each contrast item must be a list.")
  }
  contrast_type <- as.character(item$contrast_type)
  if (!length(contrast_type) || is.na(contrast_type) || !nzchar(contrast_type)) {
    contrast_type <- as.character(item$type)
  }
  if (!length(contrast_type) || is.na(contrast_type) || !nzchar(contrast_type)) {
    contrast_type <- "factor"
  }
  contrast_type <- tolower(trimws(contrast_type))
  if (!(contrast_type %in% c("factor", "coefficient"))) {
    stop("Unsupported contrast_type in explicit contrasts: ", contrast_type)
  }
  if (contrast_type == "factor") {
    factor_name <- as.character(item$factor)
    numerator <- as.character(item$numerator)
    denominator <- as.character(item$denominator)
    if (!length(factor_name) || is.na(factor_name) || !nzchar(factor_name) ||
        !length(numerator) || is.na(numerator) || !nzchar(numerator) ||
        !length(denominator) || is.na(denominator) || !nzchar(denominator)) {
      stop("Factor contrast requires non-empty factor, numerator, denominator.")
    }
    label <- as.character(item$label)
    if (!length(label) || is.na(label) || !nzchar(label)) {
      label <- paste(numerator, "vs", denominator, sep = "_")
    }
    return(list(
      contrast_type = "factor",
      factor = factor_name,
      numerator = numerator,
      denominator = denominator,
      coefficient_name = NA_character_,
      label = label
    ))
  }
  coefficient_name <- as.character(item$coefficient_name)
  if (!length(coefficient_name) || is.na(coefficient_name) || !nzchar(coefficient_name)) {
    coefficient_name <- as.character(item$name)
  }
  if (!length(coefficient_name) || is.na(coefficient_name) || !nzchar(coefficient_name)) {
    stop("Coefficient contrast requires non-empty coefficient_name (or name).")
  }
  label <- as.character(item$label)
  if (!length(label) || is.na(label) || !nzchar(label)) {
    label <- coefficient_name
  }
  list(
    contrast_type = "coefficient",
    factor = NA_character_,
    numerator = NA_character_,
    denominator = NA_character_,
    coefficient_name = coefficient_name,
    label = label
  )
}

