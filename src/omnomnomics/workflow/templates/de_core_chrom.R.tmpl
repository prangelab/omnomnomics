    assigned_col <- if ("assigned_genes.y" %in% colnames(enrich_df)) {
      "assigned_genes.y"
    } else if ("assigned_genes" %in% colnames(enrich_df)) {
      "assigned_genes"
    } else {
      NA_character_
    }
    nearest_col <- if ("nearest_gene.y" %in% colnames(enrich_df)) {
      "nearest_gene.y"
    } else if ("nearest_gene" %in% colnames(enrich_df)) {
      "nearest_gene"
    } else {
      NA_character_
    }
    enrich_df$assigned_genes <- if (!is.na(assigned_col)) as.character(enrich_df[[assigned_col]]) else rep(NA_character_, nrow(enrich_df))
    enrich_df$nearest_gene <- if (!is.na(nearest_col)) as.character(enrich_df[[nearest_col]]) else rep(NA_character_, nrow(enrich_df))
    enrich_df$genomic_region <- NULL
    suffix_cols <- intersect(c("assigned_genes.x", "assigned_genes.y", "nearest_gene.x", "nearest_gene.y"), colnames(enrich_df))
    if (length(suffix_cols) > 0) {
      enrich_df[, suffix_cols] <- NULL
    }

    first_assigned_gene <- function(x) {
      x <- as.character(x)
      if (is.na(x) || !nzchar(x) || identical(x, "NA")) {
        return(NA_character_)
      }
      primary <- strsplit(x, ",", fixed = TRUE)[[1]][1]
      primary <- trimws(primary)
      if (!nzchar(primary)) {
        return(NA_character_)
      }
      if (grepl("\\|", primary, fixed = FALSE)) {
        primary <- strsplit(primary, "\\|", perl = TRUE)[[1]][1]
      }
      primary <- trimws(primary)
      if (!nzchar(primary) || identical(primary, "NA")) {
        return(NA_character_)
      }
      primary
    }

    first_nearest_gene <- function(x) {
      x <- as.character(x)
      if (is.na(x) || !nzchar(x) || identical(x, "NA")) {
        return(NA_character_)
      }
      primary <- trimws(x)
      if (grepl("\\|", primary, fixed = FALSE)) {
        primary <- strsplit(primary, "\\|", perl = TRUE)[[1]][1]
      }
      primary <- trimws(primary)
      if (!nzchar(primary) || identical(primary, "NA")) {
        return(NA_character_)
      }
      primary
    }

    assigned_symbol <- vapply(enrich_df$assigned_genes, first_assigned_gene, character(1))
    nearest_symbol <- vapply(enrich_df$nearest_gene, first_nearest_gene, character(1))
    enrich_df$linked_gene_symbol <- nearest_symbol
    enrich_df$link_mode <- "nearest"
    promoter_like <- enrich_df$peak_region %in% c("promoter")
    gene_body_like <- enrich_df$peak_region %in% c("exon", "intron")
    enrich_df$linked_gene_symbol[promoter_like] <- assigned_symbol[promoter_like]
    enrich_df$link_mode[promoter_like] <- "promoter_assigned"
    enrich_df$linked_gene_symbol[gene_body_like & !is.na(assigned_symbol)] <- assigned_symbol[gene_body_like & !is.na(assigned_symbol)]
    enrich_df$link_mode[gene_body_like & !is.na(assigned_symbol)] <- "gene_body_assigned"
    enrich_df$linked_gene_symbol[!is_valid_symbol(enrich_df$linked_gene_symbol)] <- NA_character_
  } else {
    enrich_df$linked_gene_symbol <- enrich_df$gene_symbol
    enrich_df$linked_gene_symbol[!is_valid_symbol(enrich_df$linked_gene_symbol)] <- NA_character_
  }
  enrich_df$gene_symbol_clean <- enrich_df$linked_gene_symbol

  region_short_from_peak_region <- function(region_value) {
    rv <- tolower(trimws(as.character(region_value)))
    if (!nzchar(rv) || is.na(rv) || identical(rv, "na")) {
      return("unk")
    }
    if (rv == "promoter") {
      return("prom")
    }
    if (rv == "intergenic") {
      return("distal")
    }
    if (rv %in% c("exon", "intron")) {
      return("body")
    }
    rv
  }

  enrich_df$feature_label <- vapply(
